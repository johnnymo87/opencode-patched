diff --git a/packages/opencode/test/session/session.test.ts b/packages/opencode/test/session/session.test.ts
index c82f713d2..6c89f8981 100644
--- a/packages/opencode/test/session/session.test.ts
+++ b/packages/opencode/test/session/session.test.ts
@@ -245,4 +245,39 @@ describe("Session", () => {
       expect(saved.metadata).toBeUndefined()
     }),
   )
+
+  // mn9r M3 / bead workstation-p196: createNext must read the row back after
+  // publishing the Created event, so its return value is the canonical durable
+  // row — never a live-but-rowless in-memory Info. We assert the returned object
+  // is a DISTINCT object reference from the one carried on the published event
+  // (proving it came from a fresh fromRow(get) read), yet structurally equal.
+  it.instance("create returns the durable row read back, not the published in-memory Info", () =>
+    Effect.gen(function* () {
+      const session = yield* SessionNs.Service
+      const events = yield* EventV2Bridge.Service
+      const published = yield* Deferred.make<SessionNs.Info>()
+      const unsub = yield* events.listen((event) => {
+        if (event.type === SessionNs.Event.Created.type)
+          Deferred.doneUnsafe(
+            published,
+            Effect.succeed((event.data as typeof SessionNs.Event.Created.data.Type).info as SessionNs.Info),
+          )
+        return Effect.void
+      })
+      yield* Effect.addFinalizer(() => unsub)
+
+      const created = yield* session.create({ title: "readback" })
+      const publishedInfo = yield* awaitDeferred(published, "timed out waiting for session.created")
+      const fetched = yield* session.get(created.id)
+
+      // Canonical: the returned object equals an independent read-back.
+      expect(created).toEqual(fetched)
+      // Read-back proof: createNext returned fromRow(get(...)), a NEW object, not
+      // the in-memory Info it published. Without the read-back it returns the
+      // exact published reference and this fails.
+      expect(created).not.toBe(publishedInfo)
+
+      yield* session.remove(created.id)
+    }),
+  )
 })
