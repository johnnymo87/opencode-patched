+  it.effect("collapses availability bursts onto one credential read until the catalog changes", () => {
+    const counts = { all: 0 }
+    const layer = Catalog.locationLayer.pipe(
+      Layer.fresh,
+      Layer.provideMerge(EventV2.defaultLayer),
+      Layer.provideMerge(locationLayer),
+      Layer.provideMerge(
+        Layer.mock(Credential.Service)({
+          all: () =>
+            Effect.sync(() => {
+              counts.all++
+              return []
+            }),
+          list: () => Effect.succeed([]),
+        }),
+      ),
+    )
+
+    return Effect.gen(function* () {
+      const catalog = yield* Catalog.Service
+      const transform = yield* catalog.transform()
+      yield* transform((editor) => editor.provider.update(ProviderV2.ID.make("test"), () => {}))
+
+      counts.all = 0
+      // A bootstrap herd: many provider/model availability reads in a burst.
+      // Pre-cache this cost one credentials read per integration per call and
+      // wedged the serve under TUI reconnect herds (workstation-g3iy).
+      for (let i = 0; i < 25; i++) {
+        yield* catalog.provider.available()
+        yield* catalog.model.available()
+      }
+      expect(counts.all).toBeLessThanOrEqual(2)
+
+      // A catalog rebuild invalidates the cache: the next burst recomputes once.
+      yield* transform((editor) => editor.provider.update(ProviderV2.ID.make("other"), () => {}))
+      const after = counts.all
+      for (let i = 0; i < 25; i++) {
+        yield* catalog.provider.available()
+        yield* catalog.model.available()
+      }
+      expect(counts.all).toBeGreaterThan(after)
+      expect(counts.all).toBeLessThanOrEqual(after + 2)
+    }).pipe(Effect.provide(layer))
+  })
