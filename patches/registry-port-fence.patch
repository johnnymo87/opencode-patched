+// ---------------------------------------------------------------------------
+// Registry port fence (bead pigeon-13p)
+// ---------------------------------------------------------------------------
+
+/**
+ * The result of checking that this process actually owns the pool slot it is
+ * about to claim.
+ *
+ * WHY THIS EXISTS. `registerSelf` upserts with `ON CONFLICT(serve_id) DO UPDATE
+ * SET instance_uuid = excluded.instance_uuid, endpoint = excluded.endpoint`, so
+ * ANY process that inherits OPENCODE_SERVE_ID + OPENCODE_ROUTING_DB from its
+ * parent environment silently takes over that slot. On 2026-07-25 a throwaway
+ * `opencode serve` spawned from inside an opencode session did exactly that,
+ * twice, and pointed pigeon's serve-1 slot at the random high port it had bound.
+ * 76 sessions were routed to a closed port for hours; nothing in the system could
+ * detect or repair it (the real serve keeps heartbeating the same row healthy).
+ *
+ * WHY A PORT. Exactly one process can hold a given TCP port, so possession of the
+ * slot's port is an unforgeable fencing token and the KERNEL is the arbiter. No
+ * heartbeat inference, no takeover-delay tuning, no clock assumptions.
+ *
+ * WHY AN ENV VAR AND NOT `--port`. Comparing the bound port against this process's
+ * own `--port` would be vacuous — the throwaway was invoked with its own random
+ * `--port` and bound it successfully. The discriminating power comes from the
+ * expectation being INHERITED: the child carries the parent slot's declared port
+ * while binding somewhere else. That mismatch is the incident's signature.
+ */
+export type PortFenceVerdict =
+  | { armed: false }
+  | { armed: true; ok: true; expectedPort: number }
+  | { armed: true; ok: false; reason: "mismatch"; expectedPort: number; boundPort: number }
+  | { armed: true; ok: false; reason: "malformed"; expectedRaw: string; boundPort: number };
+
+/**
+ * Decide whether this process may claim its OPENCODE_SERVE_ID slot.
+ *
+ * ARMED ONLY WHEN THE EXPECTATION IS PRESENT. The var is set by the serve unit,
+ * which lives in a different repository from this binary, so treating "absent" as
+ * "refuse" would crash-loop the whole pool if the binary release landed before the
+ * unit rebuild. Absent therefore means today's behaviour, and the caller MUST log
+ * that the fence is off so a silently-disarmed fence is visible.
+ *
+ * A MALFORMED value is NOT treated as absent: that would let a typo silently
+ * disable the fence forever. It fails closed, which surfaces as a visible
+ * crash-loop rather than an invisibly unfenced serve.
+ */
+export function checkServePortFence(
+  expectedRaw: string | undefined,
+  boundPort: number,
+): PortFenceVerdict {
+  if (expectedRaw === undefined || expectedRaw.trim() === "") {
+    return { armed: false };
+  }
+
+  const trimmed = expectedRaw.trim();
+  // Deliberately strict: only bare decimal digits. parseInt/Number would accept
+  // "4097x", "0x1001" or "40.97" and quietly compare something else.
+  const expectedPort = /^\d+$/.test(trimmed) ? Number(trimmed) : NaN;
+  if (!Number.isInteger(expectedPort) || expectedPort < 1 || expectedPort > 65535) {
+    return { armed: true, ok: false, reason: "malformed", expectedRaw: trimmed, boundPort };
+  }
+
+  if (expectedPort !== boundPort) {
+    return { armed: true, ok: false, reason: "mismatch", expectedPort, boundPort };
+  }
+
+  return { armed: true, ok: true, expectedPort };
