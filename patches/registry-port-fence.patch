--- a/packages/opencode/test/lib/hermetic-env.test.ts
+++ b/packages/opencode/test/lib/hermetic-env.test.ts
@@ -0,0 +1,73 @@
+/**
+ * The CLI subprocess harness must not leak the RUNNER's serve-pool identity into
+ * spawned children (bead pigeon-13p).
+ *
+ * When this suite runs inside an opencode session that is itself a pool member,
+ * process.env carries OPENCODE_SERVE_ID and OPENCODE_ROUTING_DB pointing at the
+ * LIVE pigeon routing DB. A child `opencode serve` inheriting those registers
+ * itself into that pool slot: it repoints the slot at the test's random port,
+ * clobbers instance_uuid, and on teardown marks the slot draining=1 -- evicting
+ * every live session assigned to it. That happened for real on 2026-07-25
+ * (slot serve-2 -> :44407, draining=1, 83 sessions reassigned) by running the
+ * serve smoke test from inside a session.
+ *
+ * This is the fourth `opencode serve` spawn site on the box, and the only one
+ * that lives in this repo. The env scrub must therefore be enforced HERE, in the
+ * harness, not per-test -- a new test must not be able to reintroduce the hazard
+ * by forgetting to opt out.
+ */
+import { describe, expect, test } from "bun:test"
+import { hermeticBaseEnv } from "./cli-process"
+
+const HAZARDOUS = [
+  "OPENCODE_SERVE_ID",
+  "OPENCODE_ROUTING_DB",
+  "OPENCODE_SERVE_EXPECTED_PORT",
+  "OPENCODE_DB",
+  "OPENCODE_SESSION_ID",
+  "OPENCODE_WORKSPACE_ID",
+  "OPENCODE_EXPERIMENTAL_WORKSPACES",
+  "OPENCODE_HEARTBEAT_INTERVAL_MS",
+  "OPENCODE_DISABLE_CHANNEL_DB",
+] as const
+
+describe("cli-process hermetic base env", () => {
+  test("strips every host routing/identity var even when the runner has them set", () => {
+    const saved: Record<string, string | undefined> = {}
+    for (const key of HAZARDOUS) {
+      saved[key] = process.env[key]
+      // Simulate a runner hosted inside the live serve pool.
+      process.env[key] = `leaked-${key}`
+    }
+    try {
+      const base = hermeticBaseEnv()
+      for (const key of HAZARDOUS) {
+        expect(base[key], `${key} must not reach a spawned child`).toBeUndefined()
+        expect(Object.hasOwn(base, key), `${key} must be deleted, not set to undefined`).toBe(false)
+      }
+    } finally {
+      for (const key of HAZARDOUS) {
+        if (saved[key] === undefined) delete process.env[key]
+        else process.env[key] = saved[key]
+      }
+    }
+  })
+
+  test("still passes through the ordinary environment a child needs", () => {
+    const base = hermeticBaseEnv()
+    expect(base.PATH).toBe(process.env.PATH)
+    expect(base.HOME).toBe(process.env.HOME)
+  })
+
+  test("does not mutate the runner's own process.env", () => {
+    const saved = process.env.OPENCODE_SERVE_ID
+    process.env.OPENCODE_SERVE_ID = "serve-2"
+    try {
+      hermeticBaseEnv()
+      expect(process.env.OPENCODE_SERVE_ID).toBe("serve-2")
+    } finally {
+      if (saved === undefined) delete process.env.OPENCODE_SERVE_ID
+      else process.env.OPENCODE_SERVE_ID = saved
+    }
+  })
+})
