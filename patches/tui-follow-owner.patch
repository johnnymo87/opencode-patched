diff --git a/packages/tui/test/util/sse.test.ts b/packages/tui/test/util/sse.test.ts
index 1e861a7c19..b812237e6a 100644
--- a/packages/tui/test/util/sse.test.ts
+++ b/packages/tui/test/util/sse.test.ts
@@ -129,3 +129,103 @@ test("runSseAttempt balances parent-signal listeners across repeated attempts (n
   expect(adds).toBe(5)
   expect(removes).toBe(5)
 })
+
+// An async-iterable that yields nothing and only RETURNS once its bound signal
+// aborts — models a live /global/event stream sitting idle between heartbeats.
+function blockUntilAborted(signal: AbortSignal): AsyncIterable<number> {
+  return {
+    async *[Symbol.asyncIterator]() {
+      await new Promise<void>((resolve) => {
+        if (signal.aborted) return resolve()
+        signal.addEventListener("abort", () => resolve(), { once: true })
+      })
+    },
+  }
+}
+
+// poll: the owner-drift follower (bead workstation-yl00). A long-lived attempt
+// must be endable from a concurrent poll so the caller reconnects to the new
+// owning serve. The attempt's OWN per-attempt controller is reused (no new
+// AbortSignal.any chained off the long-lived parent — that was the lyj0 leak).
+
+test("runSseAttempt poll ends the attempt and reports drift when check returns true", async () => {
+  let captured: AbortSignal | undefined
+  let calls = 0
+
+  const result = await runSseAttempt<number>({
+    parentSignal: new AbortController().signal,
+    open: async (signal) => {
+      captured = signal
+      return { stream: blockUntilAborted(signal) }
+    },
+    onEvent: () => {},
+    poll: {
+      intervalMs: 1,
+      check: async () => {
+        calls += 1
+        return calls >= 2 // false once, then drift
+      },
+    },
+  })
+
+  expect(calls).toBeGreaterThanOrEqual(2)
+  expect(captured?.aborted).toBe(true)
+  expect(result?.drifted).toBe(true)
+})
+
+test("runSseAttempt poll keeps polling while check returns false; ends via parent (no drift)", async () => {
+  const parent = new AbortController()
+  let calls = 0
+
+  // End the attempt from the parent after a few poll cycles.
+  setTimeout(() => parent.abort(), 30)
+
+  const result = await runSseAttempt<number>({
+    parentSignal: parent.signal,
+    open: async (signal) => ({ stream: blockUntilAborted(signal) }),
+    onEvent: () => {},
+    poll: {
+      intervalMs: 1,
+      check: async () => {
+        calls += 1
+        return false
+      },
+    },
+  })
+
+  expect(calls).toBeGreaterThan(1) // it kept polling
+  expect(result?.drifted).toBe(false) // parent-abort end, not a drift
+})
+
+test("runSseAttempt poll swallows a throwing check and does NOT reconnect", async () => {
+  const parent = new AbortController()
+  let calls = 0
+  setTimeout(() => parent.abort(), 30)
+
+  const result = await runSseAttempt<number>({
+    parentSignal: parent.signal,
+    open: async (signal) => ({ stream: blockUntilAborted(signal) }),
+    onEvent: () => {},
+    poll: {
+      intervalMs: 1,
+      check: async () => {
+        calls += 1
+        throw new Error("pigeon /route blew up")
+      },
+    },
+  })
+
+  expect(calls).toBeGreaterThan(1) // a throw must not stop the poller
+  expect(result?.drifted).toBe(false) // a throw must never trigger reconnect
+})
+
+test("runSseAttempt without a poll still pumps events and reports no drift", async () => {
+  const events: number[] = []
+  const result = await runSseAttempt<number>({
+    parentSignal: new AbortController().signal,
+    open: async () => ({ stream: streamOf([1, 2, 3]) }),
+    onEvent: (e) => events.push(e),
+  })
+  expect(events).toEqual([1, 2, 3])
+  expect(result?.drifted).toBe(false)
+})
