+  const first = evaluateOwnerDrift(INITIAL_OWNER_DRIFT_STATE, A, B)
+  expect(first.reconnect).toBe(false)
+  const second = evaluateOwnerDrift(first.state, A, B)
+  expect(second.reconnect).toBe(true)
+  // tracker resets after firing so we don't immediately re-fire
+  expect(second.state).toEqual(INITIAL_OWNER_DRIFT_STATE)
