+test("evaluateOwnerDrift: resolved === current is no drift and resets the tracker", () => {
+  const r = evaluateOwnerDrift({ candidate: B, count: 1 }, A, A)
+  expect(r.reconnect).toBe(false)
+  expect(r.state).toEqual(INITIAL_OWNER_DRIFT_STATE)
+})
+
+test("evaluateOwnerDrift: an empty resolved url never reconnects (degrade-hard)", () => {
+  const r = evaluateOwnerDrift(INITIAL_OWNER_DRIFT_STATE, A, "")
+  expect(r.reconnect).toBe(false)
+  expect(r.state).toEqual(INITIAL_OWNER_DRIFT_STATE)
+})
+
+test("evaluateOwnerDrift: a single different url does not reconnect (needs confirmation)", () => {
+  const r = evaluateOwnerDrift(INITIAL_OWNER_DRIFT_STATE, A, B)
+  expect(r.reconnect).toBe(false)
