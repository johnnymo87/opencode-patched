+++ b/packages/tui/src/util/route.ts
@@ -80,3 +80,54 @@ export async function resolveServeUrl(opts: {
     return fallback
   }
 }
+
+/**
+ * Owner-drift tracking state for a single live SSE attempt (bead workstation-yl00).
+ * `candidate` is the new owning-serve url seen on the most recent poll(s) and
+ * `count` how many consecutive polls have now agreed on it.
+ */
+export type OwnerDriftState = {
+  candidate: string | undefined
+  count: number
+}
+
+export const INITIAL_OWNER_DRIFT_STATE: OwnerDriftState = { candidate: undefined, count: 0 }
+
+/**
+ * Decide whether a freshly-resolved owning-serve url should trigger an SSE
+ * reconnect, given the prior drift-tracking state. PURE (no network, no clock).
+ *
+ * The TUI subscribes to a per-process `/global/event` firehose pinned (at attach
+ * time) to whatever serve pigeon `/route` named then. A session can later MIGRATE
+ * to another serve (serve-lease idle-migration / pool reshuffle); its turns then
+ * emit only on the NEW serve's bus and the pinned TUI goes silent until re-attach.
+ * Polling `/route` and reconnecting on a confirmed owner change makes the stream
+ * follow the session.
+ *
+ * `resolved` is the output of resolveServeUrl, which already degrades to the
+ * current url (its `fallback`) on ANY /route failure. So `resolved === current`
+ * (or empty) means "no confirmed change" — covering pigeon-down, non-2xx, garbage
+ * body, AND a genuine no-migration — and resets the tracker. We therefore NEVER
+ * reconnect on a flake.
+ *
+ * A *different* resolved url is only acted on after it appears on `confirmations`
+ * consecutive polls (default 2), so a single flapping /route answer cannot cause
+ * reconnect thrash. A flap back to the current url, or to a third url, resets the
+ * count. After a reconnect fires, the tracker resets so we don't immediately
+ * re-fire against the same (now stale) `current`.
+ */
+export function evaluateOwnerDrift(
+  state: OwnerDriftState,
+  current: string,
+  resolved: string,
+  confirmations = 2,
+): { state: OwnerDriftState; reconnect: boolean } {
+  if (!resolved || resolved === current) {
+    return { state: INITIAL_OWNER_DRIFT_STATE, reconnect: false }
+  }
+  const count = state.candidate === resolved ? state.count + 1 : 1
+  if (count >= confirmations) {
+    return { state: INITIAL_OWNER_DRIFT_STATE, reconnect: true }
+  }
+  return { state: { candidate: resolved, count }, reconnect: false }
+}
