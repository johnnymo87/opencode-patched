--- /dev/null
+++ b/packages/tui/src/routes/session/scroll-target.ts
@@ -0,0 +1,146 @@
+/**
+ * Decision logic for tui.message.scroll (workstation-v8jh phase 2).
+ *
+ * Extracted from the session route so the delicate parts -- an off-by-one bottom
+ * test and a force override that has to beat that test -- can be exercised without
+ * standing up a renderer. The route keeps the effects; this keeps the choices.
+ */
+
+/**
+ * Is the viewport parked at the bottom, i.e. has the user NOT taken it over?
+ *
+ * Tolerance of one row matches opentui's own isAtStickyReengagePoint. Without it a
+ * token streaming in mid-jump moves scrollTop a row and reads as "the user
+ * scrolled", which would drop the very scroll the user asked for.
+ *
+ * A session with no scrollback has maxScrollTop 0 and scrollTop 0, which is at the
+ * bottom -- correct: there is nothing to take over.
+ */
+export function atBottom(scrollTop: number, scrollHeight: number, viewportHeight: number): boolean {
+  // The Math.max clamp mirrors opentui's own maxScrollTop computation. It is kept
+  // for that correspondence, not because it changes an answer: the scrollbox content
+  // carries minHeight:"100%", so post-layout scrollHeight >= viewportHeight and the
+  // subtraction is never negative. For every reachable input the clamped and
+  // unclamped forms therefore agree, no test can distinguish them, and mutating it
+  // away survives. Said plainly, with the invariant named, rather than covered by a
+  // test that would only appear to pin it.
+  const maxScrollTop = Math.max(0, scrollHeight - viewportHeight)
+  return scrollTop >= maxScrollTop - 1
+}
+
+/**
+ * Should this scroll request be recorded as the pending target?
+ *
+ * `force` marks the caller's first, user-initiated attempt -- the jump itself. It
+ * must win even against a viewport the user left scrolled up days ago, because
+ * ignoring it would silently discard an explicit request. Every later attempt is a
+ * speculative retry of a delivery whose success cannot be observed, and must not
+ * yank a viewport the user has since taken over.
+ *
+ * `bottom` is undefined when the scrollbox does not exist yet (the event can arrive
+ * before first paint). That is not "the user scrolled away", so it accepts: the
+ * effect will scroll once the anchor renders.
+ */
+export function shouldAccept(opts: {
+  eventSessionID: string
+  routeSessionID: string
+  force: boolean
+  bottom: boolean | undefined
+}): boolean {
+  if (opts.eventSessionID !== opts.routeSessionID) return false
+  if (opts.force) return true
+  return opts.bottom !== false
+}
+
+/** Messages kept above the anchor so it is not flush against the top edge, and so
+ * the shift-one eviction in sync's message.updated handler has something to eat
+ * before it reaches the anchor itself. */
+export const REACH_MARGIN = 20
+
+/** How deep a single fetch goes. Sized from measurement, not taste: over 118 real
+ * anchored events the anchor sat a median of 192 messages from the end, p75 340,
+ * max 498. 512 clears the observed maximum by only 14, so expect a low
+ * single-digit percentage of jumps to fall past it in the tail -- those degrade
+ * visibly rather than being fetched unboundedly. */
+export const REACH_LIMIT = 512
+
+/** The store's default per-session message cap, and the floor for an expanded one. */
+export const REACH_DEFAULT_CAP = 100
+
+export type ReachPlan = { outcome: "miss" } | { outcome: "hit"; window: string[] }
+
+/**
+ * Which slice of a deep fetch is worth keeping, given the anchor we must render.
+ *
+ * The renderer is not virtualized (`<For each={messages()}>`), so scrolling to a
+ * message requires it to be rendered, which requires it to be in the store. But the
+ * store deliberately holds only the newest REACH_DEFAULT_CAP to bound render cost, so
+ * reaching an older anchor means paying for everything between it and the present. We
+ * therefore keep only what the jump needs -- anchor minus a margin, not the whole
+ * fetch -- so the rendered count is the anchor's distance plus the margin (median
+ * ~210 for real anchors) rather than REACH_LIMIT every time.
+ *
+ * Deliberately says nothing about what is already in the store: by the time the fetch
+ * returns, that snapshot is seconds stale. Reconciling against the live list is
+ * mergeReach's job.
+ */
+export function planReach(opts: { fetched: string[]; target: string; margin: number }): ReachPlan {
+  const index = opts.fetched.indexOf(opts.target)
+  // Not in the deepest fetch we are willing to make. The caller degrades visibly; it
+  // must not fetch again, or a very old anchor becomes an unbounded walk backwards.
+  if (index === -1) return { outcome: "miss" }
+  return { outcome: "hit", window: opts.fetched.slice(Math.max(0, index - opts.margin)) }
+}
+
+type Ordered = { id: string; time: { created: number } }
+
+/**
+ * Is `a` strictly older than `b`?
+ *
+ * Mirrors sync's compareMessage (created time, then id as the tiebreak) because the
+ * store's message list must stay sorted -- an unsorted list silently breaks the
+ * binary search that later inserts rely on, which would duplicate messages rather
+ * than fail. Duplicated here rather than imported to avoid a cycle: sync imports this
+ * module, not the other way round.
+ */
+export function isOlderThan(a: Ordered, b: Ordered): boolean {
+  if (a.time.created !== b.time.created) return a.time.created < b.time.created
+  return a.id.localeCompare(b.id) < 0
+}
+
+/**
+ * Reconcile a deep fetch against the CURRENT store contents.
+ *
+ * Must run against the live list, not a snapshot taken before the fetch: the fetch
+ * takes seconds (~7.6s measured on a 759-message session) and messages can arrive
+ * meanwhile. Re-adding one of those would both duplicate it and overwrite its live
+ * streaming parts with a stale copy, which strands the text mid-stream.
+ *
+ * The ordering guard is what keeps the store's invariant: only strictly-older
+ * messages may be prepended, so the result stays sorted no matter what the fetch
+ * returned or what arrived while it was in flight.
+ */
+export function mergeReach<T extends Ordered>(opts: {
+  current: T[]
+  candidates: T[]
+}): { prepend: T[]; cap: number } {
+  const have = new Set(opts.current.map((message) => message.id))
+  const oldest = opts.current[0]
+  // Two guards. The strictly-older test is the load-bearing one: it alone rejects a
+  // message that is absent from the store but newer than its oldest entry -- which
+  // happens when a revert has punched a hole in the retained window. The
+  // already-present test is redundant while `current` is sorted (anything in it is by
+  // definition not older than its first element), so no test can distinguish it and
+  // removing it survives mutation. It is kept as the cheap direct expression of "do
+  // not re-add what we already have", and said plainly here rather than covered by a
+  // test that would only appear to pin it.
+  const prepend = opts.candidates.filter(
+    (candidate) => !have.has(candidate.id) && (!oldest || isOlderThan(candidate, oldest)),
+  )
+  // Computed from what is actually in the list after this merge, not from the
+  // pre-fetch snapshot, or arrivals during the fetch would push the real length past
+  // the cap and the shift-one eviction would start eating the history we just paid
+  // seven seconds for.
+  const cap = Math.max(REACH_DEFAULT_CAP, prepend.length + opts.current.length)
+  return { prepend, cap }
+}
