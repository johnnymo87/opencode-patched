diff --git a/packages/tui/src/routes/session/scroll-target.ts b/packages/tui/src/routes/session/scroll-target.ts
new file mode 100644
index 0000000000..73b95e92d2
--- /dev/null
+++ b/packages/tui/src/routes/session/scroll-target.ts
@@ -0,0 +1,51 @@
+/**
+ * Decision logic for tui.message.scroll (workstation-v8jh phase 2).
+ *
+ * Extracted from the session route so the delicate parts -- an off-by-one bottom
+ * test and a force override that has to beat that test -- can be exercised without
+ * standing up a renderer. The route keeps the effects; this keeps the choices.
+ */
+
+/**
+ * Is the viewport parked at the bottom, i.e. has the user NOT taken it over?
+ *
+ * Tolerance of one row matches opentui's own isAtStickyReengagePoint. Without it a
+ * token streaming in mid-jump moves scrollTop a row and reads as "the user
+ * scrolled", which would drop the very scroll the user asked for.
+ *
+ * A session with no scrollback has maxScrollTop 0 and scrollTop 0, which is at the
+ * bottom -- correct: there is nothing to take over.
+ */
+export function atBottom(scrollTop: number, scrollHeight: number, viewportHeight: number): boolean {
+  // The Math.max clamp mirrors opentui's own maxScrollTop computation. It is kept
+  // for that correspondence, not because it changes an answer: for every reachable
+  // input (scrollTop >= 0) the clamped and unclamped forms agree, so no test can
+  // distinguish them and mutating it away survives. Said plainly rather than
+  // covered by a test that would only appear to pin it.
+  const maxScrollTop = Math.max(0, scrollHeight - viewportHeight)
+  return scrollTop >= maxScrollTop - 1
+}
+
+/**
+ * Should this scroll request be recorded as the pending target?
+ *
+ * `force` marks the caller's first, user-initiated attempt -- the jump itself. It
+ * must win even against a viewport the user left scrolled up days ago, because
+ * ignoring it would silently discard an explicit request. Every later attempt is a
+ * speculative retry of a delivery whose success cannot be observed, and must not
+ * yank a viewport the user has since taken over.
+ *
+ * `bottom` is undefined when the scrollbox does not exist yet (the event can arrive
+ * before first paint). That is not "the user scrolled away", so it accepts: the
+ * effect will scroll once the anchor renders.
+ */
+export function shouldAccept(opts: {
+  eventSessionID: string
+  routeSessionID: string
+  force: boolean
+  bottom: boolean | undefined
+}): boolean {
+  if (opts.eventSessionID !== opts.routeSessionID) return false
+  if (opts.force) return true
+  return opts.bottom !== false
+}
diff --git a/packages/tui/test/routes/session/scroll-target.test.ts b/packages/tui/test/routes/session/scroll-target.test.ts
new file mode 100644
index 0000000000..19c9456ef3
--- /dev/null
+++ b/packages/tui/test/routes/session/scroll-target.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, test } from "bun:test"
+import { atBottom, shouldAccept } from "../../../src/routes/session/scroll-target"
+
+// workstation-v8jh phase 2. These pin the two decisions that are easy to get
+// subtly wrong and impossible to notice: the one-row tolerance on the bottom
+// test, and force having to beat that test.
+
+describe("atBottom", () => {
+  test("exactly at the bottom", () => {
+    // scrollHeight 500, viewport 100 -> maxScrollTop 400
+    expect(atBottom(400, 500, 100)).toBe(true)
+  })
+
+  test("one row up still counts, so a streaming token does not read as a user scroll", () => {
+    expect(atBottom(399, 500, 100)).toBe(true)
+  })
+
+  test("two rows up does not count -- that is a user who scrolled", () => {
+    expect(atBottom(398, 500, 100)).toBe(false)
+  })
+
+  test("far from the bottom", () => {
+    expect(atBottom(0, 500, 100)).toBe(false)
+  })
+
+  test("a session with no scrollback is at the bottom", () => {
+    // Nothing to take over: maxScrollTop clamps to 0 and scrollTop is 0.
+    expect(atBottom(0, 40, 100)).toBe(true)
+  })
+
+  test("content shorter than the viewport never reports 'scrolled away'", () => {
+    expect(atBottom(0, 10, 100)).toBe(true)
+  })
+})
+
+describe("shouldAccept", () => {
+  const base = { eventSessionID: "ses_a", routeSessionID: "ses_a", force: false, bottom: true }
+
+  test("accepts a bottom-parked viewport", () => {
+    expect(shouldAccept(base)).toBe(true)
+  })
+
+  test("rejects another session's event", () => {
+    // The SSE filter scopes by sessionID, but a serve hosting two sessions can
+    // still deliver here; without this the wrong transcript jumps.
+    expect(shouldAccept({ ...base, eventSessionID: "ses_b" })).toBe(false)
+  })
+
+  test("rejects a speculative retry once the user has scrolled away", () => {
+    expect(shouldAccept({ ...base, bottom: false })).toBe(false)
+  })
+
+  test("force beats a scrolled-away viewport -- it is the user's own jump", () => {
+    // The warm case this exists for: a session left scrolled up days ago. Without
+    // force, every attempt drops and pressing jump appears to do nothing.
+    expect(shouldAccept({ ...base, force: true, bottom: false })).toBe(true)
+  })
+
+  test("force does NOT cross sessions", () => {
+    expect(shouldAccept({ ...base, eventSessionID: "ses_b", force: true, bottom: false })).toBe(false)
+  })
+
+  test("accepts before first paint, when there is no scrollbox to judge", () => {
+    // Arriving pre-render is the common cold-attach case; treating "unknown" as
+    // "scrolled away" would drop precisely the attempts that matter most.
+    expect(shouldAccept({ ...base, bottom: undefined })).toBe(true)
+  })
+
+  test("accepts before first paint even without force", () => {
+    expect(shouldAccept({ ...base, force: false, bottom: undefined })).toBe(true)
+  })
+})
