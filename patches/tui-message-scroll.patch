+import { describe, expect, test } from "bun:test"
+import { atBottom, isOlderThan, mergeReach, planReach, shouldAccept } from "../../../src/routes/session/scroll-target"
+
+// workstation-v8jh phase 2. These pin the two decisions that are easy to get
+// subtly wrong and impossible to notice: the one-row tolerance on the bottom
+// test, and force having to beat that test.
+
+describe("atBottom", () => {
+  test("exactly at the bottom", () => {
+    // scrollHeight 500, viewport 100 -> maxScrollTop 400
+    expect(atBottom(400, 500, 100)).toBe(true)
+  })
+
+  test("one row up still counts, so a streaming token does not read as a user scroll", () => {
+    expect(atBottom(399, 500, 100)).toBe(true)
+  })
+
+  test("two rows up does not count -- that is a user who scrolled", () => {
+    expect(atBottom(398, 500, 100)).toBe(false)
+  })
+
+  test("far from the bottom", () => {
+    expect(atBottom(0, 500, 100)).toBe(false)
+  })
+
+  test("a session with no scrollback is at the bottom", () => {
+    // Nothing to take over: maxScrollTop clamps to 0 and scrollTop is 0.
+    expect(atBottom(0, 40, 100)).toBe(true)
+  })
+
+  test("content shorter than the viewport never reports 'scrolled away'", () => {
+    expect(atBottom(0, 10, 100)).toBe(true)
+  })
+})
+
+describe("shouldAccept", () => {
+  const base = { eventSessionID: "ses_a", routeSessionID: "ses_a", force: false, bottom: true }
+
+  test("accepts a bottom-parked viewport", () => {
+    expect(shouldAccept(base)).toBe(true)
+  })
+
+  test("rejects another session's event", () => {
+    // The SSE filter scopes by sessionID, but a serve hosting two sessions can
+    // still deliver here; without this the wrong transcript jumps.
+    expect(shouldAccept({ ...base, eventSessionID: "ses_b" })).toBe(false)
+  })
+
+  test("rejects a speculative retry once the user has scrolled away", () => {
+    expect(shouldAccept({ ...base, bottom: false })).toBe(false)
+  })
+
+  test("force beats a scrolled-away viewport -- it is the user's own jump", () => {
+    // The warm case this exists for: a session left scrolled up days ago. Without
+    // force, every attempt drops and pressing jump appears to do nothing.
+    expect(shouldAccept({ ...base, force: true, bottom: false })).toBe(true)
+  })
+
+  test("force does NOT cross sessions", () => {
+    expect(shouldAccept({ ...base, eventSessionID: "ses_b", force: true, bottom: false })).toBe(false)
+  })
+
+  test("accepts before first paint, when there is no scrollbox to judge", () => {
+    // Arriving pre-render is the common cold-attach case; treating "unknown" as
+    // "scrolled away" would drop precisely the attempts that matter most.
+    expect(shouldAccept({ ...base, bottom: undefined })).toBe(true)
+  })
+
+  test("force with no scrollbox yet still accepts", () => {
+    // The cold-attach shape: attempt 0 arrives before first paint.
+    expect(shouldAccept({ ...base, force: true, bottom: undefined })).toBe(true)
+  })
+})
+
+// workstation-psh9. The reach fix: the anchor is usually NOT in the store (median
+// 192 messages back, only 27% within the newest 100), so a deep fetch has to
+// decide what to prepend and how far to raise the per-session cap. These pin the
+// arithmetic; the store mutation itself lives in sync.tsx.
+
+describe("planReach", () => {
+  const ids = (from: number, to: number) => Array.from({ length: to - from + 1 }, (_, i) => `msg_${from + i}`)
+
+  test("anchor absent from the deep fetch is a miss -- caller shows the degraded notice", () => {
+    expect(planReach({ fetched: ids(50, 99), target: "msg_1", margin: 20 }).outcome).toBe("miss")
+  })
+
+  test("window starts a margin above the anchor, not at the start of the fetch", () => {
+    const plan = planReach({ fetched: ids(50, 99), target: "msg_80", margin: 5 })
+    if (plan.outcome !== "hit") throw new Error("expected hit")
+    expect(plan.window[0]).toBe("msg_75")
+    // and runs to the present, so the merge can splice it onto the live tail
+    expect(plan.window.at(-1)).toBe("msg_99")
+  })
+
+  test("margin is clamped at the start of the fetch rather than going negative", () => {
+    const plan = planReach({ fetched: ids(50, 99), target: "msg_52", margin: 20 })
+    if (plan.outcome !== "hit") throw new Error("expected hit")
+    expect(plan.window[0]).toBe("msg_50")
+  })
+
+  test("margin 0 puts the anchor itself at the start of the window", () => {
+    const plan = planReach({ fetched: ids(50, 99), target: "msg_80", margin: 0 })
+    if (plan.outcome !== "hit") throw new Error("expected hit")
+    expect(plan.window[0]).toBe("msg_80")
+  })
+})
+
+// The merge runs against the LIVE store, seconds after the fetch was issued, so these
+// pin what happens when the world moved underneath it.
+describe("mergeReach", () => {
+  const m = (n: number, created = n) => ({ id: `msg_${String(n).padStart(3, "0")}`, time: { created } })
+  const range = (from: number, to: number) => Array.from({ length: to - from + 1 }, (_, i) => m(from + i))
+
+  test("prepends only what the store lacks", () => {
+    const merged = mergeReach({ current: range(90, 99), candidates: range(75, 99) })
+    expect(merged.prepend.map((x) => x.id)).toEqual(range(75, 89).map((x) => x.id))
+  })
+
+  test("a message that ARRIVED during the fetch is not re-added or re-parted", () => {
+    // fetch returned 75..99; meanwhile msg_100 landed live. It must not be prepended:
+    // doing so would duplicate it and clobber its streaming parts with a stale copy.
+    const merged = mergeReach({ current: [...range(90, 99), m(100)], candidates: [...range(75, 99), m(100)] })
+    expect(merged.prepend.some((x) => x.id === "msg_100")).toBe(false)
+  })
+
+  test("a candidate NEWER than the store's oldest is refused, keeping the list sorted", () => {
+    // Only strictly-older messages may be prepended; an out-of-order splice would
+    // silently break the binary search that later inserts rely on.
+    const merged = mergeReach({ current: range(90, 99), candidates: [m(95), m(80)] })
+    expect(merged.prepend.map((x) => x.id)).toEqual(["msg_080"])
+  })
+
+  test("a fetched message filling a GAP in the store is refused, not spliced out of order", () => {
+    // The store can have holes: message.removed (a revert) can delete something in the
+    // middle of the retained window. The fetch still returns it, and it is NOT in the
+    // store -- so the already-present check passes it -- but prepending it would put a
+    // newer message in front of older ones and silently break the sortedness that the
+    // store's binary-search inserts depend on. Only the strictly-older test catches
+    // this, which is why both guards exist.
+    const withHole = [m(90), ...range(92, 99)]
+    const merged = mergeReach({ current: withHole, candidates: [m(80), m(91)] })
+    expect(merged.prepend.map((x) => x.id)).toEqual(["msg_080"])
+  })
+
+  test("cap reflects the ACTUAL post-merge length, not a pre-fetch snapshot", () => {
+    const merged = mergeReach({ current: range(400, 499), candidates: range(280, 499) })
+    expect(merged.prepend.length).toBe(120)
+    expect(merged.cap).toBe(220)
+  })
+
+  test("cap never drops below the default, so a small session is not left tighter than normal", () => {
+    const merged = mergeReach({ current: range(98, 99), candidates: range(95, 99) })
+    expect(merged.cap).toBe(100)
+  })
+
+  test("empty store still merges (nothing to be older than)", () => {
+    const merged = mergeReach({ current: [], candidates: range(75, 99) })
+    expect(merged.prepend.length).toBe(25)
+  })
+
+  test("ties on created time fall back to id, matching the store's own comparator", () => {
+    expect(isOlderThan(m(1, 500), m(2, 500))).toBe(true)
+    expect(isOlderThan(m(2, 500), m(1, 500))).toBe(false)
+    expect(isOlderThan(m(9, 100), m(1, 500))).toBe(true)
+  })
+})
