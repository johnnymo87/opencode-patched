diff --git a/packages/tui/src/util/route.ts b/packages/tui/src/util/route.ts
new file mode 100644
index 000000000..841e51dbb
--- /dev/null
+++ b/packages/tui/src/util/route.ts
@@ -0,0 +1,82 @@
+/**
+ * Pool-aware serve resolution via the pigeon ingress router's `GET /route`.
+ *
+ * In a pool of K `opencode serve` processes sharing one `opencode.db`, pigeon
+ * places each session on one serve (HRW rendezvous). opencode's streaming event
+ * bus is in-memory per process, so a TUI only receives a session's turns if it
+ * is attached to the serve that actually runs the session. This resolves the
+ * owning serve for a session id.
+ *
+ * Mirrors the bash `parse_serve_url` + curl flow in workstation
+ * `pkgs/oc-auto-attach/default.nix`: extract `.apiBase` from a `GET /route` body
+ * and degrade to a caller-supplied fallback on ANY failure (pigeon down, non-2xx,
+ * empty/garbage body, missing/null/empty `apiBase`). The fix can never be worse
+ * than the pre-pool single-serve behavior.
+ */
+
+const DEFAULT_PIGEON_URL = "http://127.0.0.1:4731"
+
+/**
+ * Extract `.apiBase` from a pigeon `GET /route` JSON body. Pure (no network).
+ * Returns `fallback` when the body is empty, not JSON, or `apiBase` is
+ * absent/null/empty/non-string. Never throws.
+ */
+export function parseServeUrl(body: string, fallback: string): string {
+  try {
+    const parsed = JSON.parse(body) as unknown
+    if (parsed && typeof parsed === "object") {
+      const apiBase = (parsed as { apiBase?: unknown }).apiBase
+      if (typeof apiBase === "string" && apiBase.length > 0) return apiBase
+    }
+  } catch {
+    // not JSON — fall through to the fallback
+  }
+  return fallback
+}
+
+/** The pigeon daemon base URL, matching `opencode-send`/`oc-auto-attach`. */
+export function pigeonDaemonUrl(): string {
+  const env = typeof process !== "undefined" ? process.env?.PIGEON_DAEMON_URL : undefined
+  return env && env.length > 0 ? env : DEFAULT_PIGEON_URL
+}
+
+/**
+ * Resolve the owning serve's base URL for a session via pigeon `GET /route`.
+ * Bounded by a short timeout so a hung/absent pigeon cannot stall attach or an
+ * SSE reconnect. NEVER throws: any failure returns `fallback`.
+ */
+export async function resolveServeUrl(opts: {
+  sessionID: string
+  fallback: string
+  pigeonUrl?: string
+  fetch?: typeof fetch
+  signal?: AbortSignal
+  timeoutMs?: number
+}): Promise<string> {
+  const { sessionID, fallback } = opts
+  if (!sessionID) return fallback
+
+  const pigeonUrl = (opts.pigeonUrl ?? pigeonDaemonUrl()).replace(/\/+$/, "")
+  const fetchFn = opts.fetch ?? fetch
+  const url = `${pigeonUrl}/route?session_id=${encodeURIComponent(sessionID)}`
+
+  const timeoutMs = opts.timeoutMs ?? 3000
+  let signal: AbortSignal | undefined
+  try {
+    const timeoutSignal = AbortSignal.timeout(timeoutMs)
+    signal = opts.signal ? AbortSignal.any([opts.signal, timeoutSignal]) : timeoutSignal
+  } catch {
+    // AbortSignal.timeout/any unavailable — proceed without a bound rather than
+    // failing the resolve outright.
+    signal = opts.signal
+  }
+
+  try {
+    const res = await fetchFn(url, { signal })
+    if (!res.ok) return fallback
+    const body = await res.text()
+    return parseServeUrl(body, fallback)
+  } catch {
+    return fallback
+  }
+}
