diff --git a/packages/tui/src/util/route.ts b/packages/tui/src/util/route.ts
new file mode 100644
index 000000000..841e51dbb
--- /dev/null
+++ b/packages/tui/src/util/route.ts
@@ -0,0 +1,82 @@
+/**
+ * Pool-aware serve resolution via the pigeon ingress router's `GET /route`.
+ *
+ * In a pool of K `opencode serve` processes sharing one `opencode.db`, pigeon
+ * places each session on one serve (HRW rendezvous). opencode's streaming event
+ * bus is in-memory per process, so a TUI only receives a session's turns if it
+ * is attached to the serve that actually runs the session. This resolves the
+ * owning serve for a session id.
+ *
+ * Mirrors the bash `parse_serve_url` + curl flow in workstation
+ * `pkgs/oc-auto-attach/default.nix`: extract `.apiBase` from a `GET /route` body
+ * and degrade to a caller-supplied fallback on ANY failure (pigeon down, non-2xx,
+ * empty/garbage body, missing/null/empty `apiBase`). The fix can never be worse
+ * than the pre-pool single-serve behavior.
+ */
+
+const DEFAULT_PIGEON_URL = "http://127.0.0.1:4731"
+
+/**
+ * Extract `.apiBase` from a pigeon `GET /route` JSON body. Pure (no network).
+ * Returns `fallback` when the body is empty, not JSON, or `apiBase` is
+ * absent/null/empty/non-string. Never throws.
+ */
+export function parseServeUrl(body: string, fallback: string): string {
+  try {
+    const parsed = JSON.parse(body) as unknown
+    if (parsed && typeof parsed === "object") {
+      const apiBase = (parsed as { apiBase?: unknown }).apiBase
+      if (typeof apiBase === "string" && apiBase.length > 0) return apiBase
+    }
+  } catch {
+    // not JSON — fall through to the fallback
+  }
+  return fallback
+}
+
+/** The pigeon daemon base URL, matching `opencode-send`/`oc-auto-attach`. */
+export function pigeonDaemonUrl(): string {
+  const env = typeof process !== "undefined" ? process.env?.PIGEON_DAEMON_URL : undefined
+  return env && env.length > 0 ? env : DEFAULT_PIGEON_URL
+}
+
+/**
+ * Resolve the owning serve's base URL for a session via pigeon `GET /route`.
+ * Bounded by a short timeout so a hung/absent pigeon cannot stall attach or an
+ * SSE reconnect. NEVER throws: any failure returns `fallback`.
+ */
+export async function resolveServeUrl(opts: {
+  sessionID: string
+  fallback: string
+  pigeonUrl?: string
+  fetch?: typeof fetch
+  signal?: AbortSignal
+  timeoutMs?: number
+}): Promise<string> {
+  const { sessionID, fallback } = opts
+  if (!sessionID) return fallback
+
+  const pigeonUrl = (opts.pigeonUrl ?? pigeonDaemonUrl()).replace(/\/+$/, "")
+  const fetchFn = opts.fetch ?? fetch
+  const url = `${pigeonUrl}/route?session_id=${encodeURIComponent(sessionID)}`
+
+  const timeoutMs = opts.timeoutMs ?? 3000
+  let signal: AbortSignal | undefined
+  try {
+    const timeoutSignal = AbortSignal.timeout(timeoutMs)
+    signal = opts.signal ? AbortSignal.any([opts.signal, timeoutSignal]) : timeoutSignal
+  } catch {
+    // AbortSignal.timeout/any unavailable — proceed without a bound rather than
+    // failing the resolve outright.
+    signal = opts.signal
+  }
+
+  try {
+    const res = await fetchFn(url, { signal })
+    if (!res.ok) return fallback
+    const body = await res.text()
+    return parseServeUrl(body, fallback)
+  } catch {
+    return fallback
+  }
+}
diff --git a/packages/tui/test/util/route.test.ts b/packages/tui/test/util/route.test.ts
new file mode 100644
index 000000000..f2a80130c
--- /dev/null
+++ b/packages/tui/test/util/route.test.ts
@@ -0,0 +1,91 @@
+import { expect, test } from "bun:test"
+import { parseServeUrl, resolveServeUrl } from "../../src/util/route"
+
+// parseServeUrl: pure extraction of .apiBase from a pigeon `GET /route` body,
+// degrading to the fallback on anything unexpected. Mirrors the bash
+// parse_serve_url in workstation pkgs/oc-auto-attach/default.nix.
+
+test("parseServeUrl returns apiBase from a valid route body", () => {
+  const body = JSON.stringify({
+    apiBase: "http://127.0.0.1:4097",
+    eventUrl: "http://127.0.0.1:4097/event?session_ids=ses_x",
+  })
+  expect(parseServeUrl(body, "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4097")
+})
+
+test("parseServeUrl falls back on an empty body", () => {
+  expect(parseServeUrl("", "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4096")
+})
+
+test("parseServeUrl falls back on non-JSON garbage", () => {
+  expect(parseServeUrl("not json at all", "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4096")
+})
+
+test("parseServeUrl falls back when apiBase is absent", () => {
+  expect(parseServeUrl(JSON.stringify({ serveId: "serve-1" }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is null", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: null }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is an empty string", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: "" }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is not a string", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: 4097 }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+// resolveServeUrl: the network wrapper. It must NEVER throw and must degrade to
+// the fallback on any failure (non-2xx, connection refused, bad body).
+
+test("resolveServeUrl queries pigeon /route and returns the owning serve apiBase", async () => {
+  let requestedUrl = ""
+  const fakeFetch = (async (url: string | URL | Request) => {
+    requestedUrl = String(url)
+    return new Response(JSON.stringify({ apiBase: "http://127.0.0.1:4097" }), { status: 200 })
+  }) as unknown as typeof fetch
+
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+
+  expect(result).toBe("http://127.0.0.1:4097")
+  expect(requestedUrl).toBe("http://127.0.0.1:4731/route?session_id=ses_abc")
+})
+
+test("resolveServeUrl falls back when pigeon returns 503", async () => {
+  const fakeFetch = (async () => new Response("", { status: 503 })) as unknown as typeof fetch
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+  expect(result).toBe("http://127.0.0.1:4096")
+})
+
+test("resolveServeUrl falls back when fetch throws (connection refused)", async () => {
+  const fakeFetch = (async () => {
+    throw new Error("connect ECONNREFUSED 127.0.0.1:4731")
+  }) as unknown as typeof fetch
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+  expect(result).toBe("http://127.0.0.1:4096")
+})
