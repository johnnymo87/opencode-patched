@@ -0,0 +1,91 @@
+import { expect, test } from "bun:test"
+import { parseServeUrl, resolveServeUrl } from "../../src/util/route"
+
+// parseServeUrl: pure extraction of .apiBase from a pigeon `GET /route` body,
+// degrading to the fallback on anything unexpected. Mirrors the bash
+// parse_serve_url in workstation pkgs/oc-auto-attach/default.nix.
+
+test("parseServeUrl returns apiBase from a valid route body", () => {
+  const body = JSON.stringify({
+    apiBase: "http://127.0.0.1:4097",
+    eventUrl: "http://127.0.0.1:4097/event?session_ids=ses_x",
+  })
+  expect(parseServeUrl(body, "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4097")
+})
+
+test("parseServeUrl falls back on an empty body", () => {
+  expect(parseServeUrl("", "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4096")
+})
+
+test("parseServeUrl falls back on non-JSON garbage", () => {
+  expect(parseServeUrl("not json at all", "http://127.0.0.1:4096")).toBe("http://127.0.0.1:4096")
+})
+
+test("parseServeUrl falls back when apiBase is absent", () => {
+  expect(parseServeUrl(JSON.stringify({ serveId: "serve-1" }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is null", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: null }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is an empty string", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: "" }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+test("parseServeUrl falls back when apiBase is not a string", () => {
+  expect(parseServeUrl(JSON.stringify({ apiBase: 4097 }), "http://127.0.0.1:4096")).toBe(
+    "http://127.0.0.1:4096",
+  )
+})
+
+// resolveServeUrl: the network wrapper. It must NEVER throw and must degrade to
+// the fallback on any failure (non-2xx, connection refused, bad body).
+
+test("resolveServeUrl queries pigeon /route and returns the owning serve apiBase", async () => {
+  let requestedUrl = ""
+  const fakeFetch = (async (url: string | URL | Request) => {
+    requestedUrl = String(url)
+    return new Response(JSON.stringify({ apiBase: "http://127.0.0.1:4097" }), { status: 200 })
+  }) as unknown as typeof fetch
+
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+
+  expect(result).toBe("http://127.0.0.1:4097")
+  expect(requestedUrl).toBe("http://127.0.0.1:4731/route?session_id=ses_abc")
+})
+
+test("resolveServeUrl falls back when pigeon returns 503", async () => {
+  const fakeFetch = (async () => new Response("", { status: 503 })) as unknown as typeof fetch
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+  expect(result).toBe("http://127.0.0.1:4096")
+})
+
+test("resolveServeUrl falls back when fetch throws (connection refused)", async () => {
+  const fakeFetch = (async () => {
+    throw new Error("connect ECONNREFUSED 127.0.0.1:4731")
+  }) as unknown as typeof fetch
+  const result = await resolveServeUrl({
+    sessionID: "ses_abc",
+    fallback: "http://127.0.0.1:4096",
+    pigeonUrl: "http://127.0.0.1:4731",
+    fetch: fakeFetch,
+  })
+  expect(result).toBe("http://127.0.0.1:4096")
+})
diff --git a/packages/tui/src/util/sse.ts b/packages/tui/src/util/sse.ts
new file mode 100644
index 000000000..bad573530
--- /dev/null
+++ b/packages/tui/src/util/sse.ts
@@ -0,0 +1,58 @@
+/**
+ * Run ONE SSE connect+pump attempt with guaranteed teardown.
+ *
+ * `open(signal)` opens an event stream bound to a FRESH per-attempt
+ * AbortController; every event is pumped to `onEvent`; and — no matter how the
+ * attempt ends (stream completes, throws mid-stream, or `parentSignal` aborts)
+ * — that controller is aborted in a `finally`. Aborting forces the underlying
+ * fetch/connection closed instead of leaving it ESTABLISHED in the client's
+ * keep-alive pool.
+ *
+ * Why this matters: the previous reconnect loop shared ONE long-lived
+ * AbortController across every reconnect and never closed a finished attempt's
+ * stream, so each reconnect leaked one ESTABLISHED connection up to the
+ * per-origin pool cap (256). 18 idle `opencode attach` TUIs that all fell back
+ * to the default serve thereby pinned a single serve's event loop with ~4600
+ * connections (bead workstation-lyj0).
+ *
+ * The parent->attempt abort bridge is registered AND removed every call
+ * (balanced), so repeated calls against one long-lived `parentSignal` never
+ * accumulate listeners — the prior `AbortSignal.any(...)`-per-iteration form
+ * added a listener it never removed, tripping Node's
+ * MaxListenersExceededWarning.
+ *
+ * Never throws: connect/iterate errors are swallowed so the caller's reconnect
+ * loop continues (matches the prior inline behavior).
+ */
+export async function runSseAttempt<T>(opts: {
+  open: (signal: AbortSignal) => Promise<{ stream: AsyncIterable<T> }>
+  onEvent: (event: T) => void
+  parentSignal: AbortSignal
+  onOpen?: () => void | Promise<void>
+}): Promise<void> {
+  const { open, onEvent, parentSignal, onOpen } = opts
+
+  const attempt = new AbortController()
+  const onParentAbort = () => attempt.abort()
+
+  if (parentSignal.aborted) {
+    attempt.abort()
+  } else {
+    parentSignal.addEventListener("abort", onParentAbort, { once: true })
+  }
+
+  try {
+    const events = await open(attempt.signal)
+    await onOpen?.()
+    for await (const event of events.stream) {
+      if (attempt.signal.aborted) break
+      onEvent(event)
+    }
+  } catch {
+    // Connect/stream error (non-2xx, refused connection, mid-stream drop):
+    // swallow and let the caller back off + reconnect.
+  } finally {
+    attempt.abort()
+    parentSignal.removeEventListener("abort", onParentAbort)
+  }
+}
diff --git a/packages/tui/test/util/sse.test.ts b/packages/tui/test/util/sse.test.ts
new file mode 100644
index 000000000..1e861a7c1
--- /dev/null
+++ b/packages/tui/test/util/sse.test.ts
@@ -0,0 +1,131 @@
+import { expect, test } from "bun:test"
+import { runSseAttempt } from "../../src/util/sse"
+
+// An async-iterable backed by an array, optionally throwing mid-stream to
+// simulate a dropped SSE connection.
+function streamOf<T>(items: T[], opts: { throwAfter?: number } = {}): AsyncIterable<T> {
+  return {
+    async *[Symbol.asyncIterator]() {
+      let i = 0
+      for (const item of items) {
+        yield item
+        i++
+        if (opts.throwAfter !== undefined && i === opts.throwAfter) {
+          throw new Error("simulated stream drop")
+        }
+      }
+    },
+  }
+}
+
+test("runSseAttempt pumps every event then aborts the attempt signal when the stream ends", async () => {
+  let captured: AbortSignal | undefined
+  const events: number[] = []
+
+  await runSseAttempt<number>({
+    parentSignal: new AbortController().signal,
+    open: async (signal) => {
+      captured = signal
+      return { stream: streamOf([1, 2, 3]) }
+    },
+    onEvent: (e) => events.push(e),
+  })
+
+  expect(events).toEqual([1, 2, 3])
+  // The per-attempt controller is aborted in finally so the underlying
+  // fetch/connection is torn down instead of lingering ESTABLISHED.
+  expect(captured?.aborted).toBe(true)
+})
+
+test("runSseAttempt swallows a mid-stream error and still aborts the attempt", async () => {
+  let captured: AbortSignal | undefined
+  const events: number[] = []
+
+  // Must not throw out of runSseAttempt — the caller's reconnect loop relies on
+  // it returning so it can back off and reconnect.
+  await runSseAttempt<number>({
+    parentSignal: new AbortController().signal,
+    open: async (signal) => {
+      captured = signal
+      return { stream: streamOf([1, 2], { throwAfter: 2 }) }
+    },
+    onEvent: (e) => events.push(e),
+  })
+
+  expect(events).toEqual([1, 2])
+  expect(captured?.aborted).toBe(true)
+})
+
+test("runSseAttempt stops pumping and aborts when the parent signal aborts mid-stream", async () => {
+  const parent = new AbortController()
+  let captured: AbortSignal | undefined
+  const events: number[] = []
+
+  const stream: AsyncIterable<number> = {
+    async *[Symbol.asyncIterator]() {
+      for (let i = 1; i <= 100; i++) {
+        if (captured?.aborted) return
+        yield i
+      }
+    },
+  }
+
+  await runSseAttempt<number>({
+    parentSignal: parent.signal,
+    open: async (signal) => {
+      captured = signal
+      return { stream }
+    },
+    onEvent: (e) => {
+      events.push(e)
+      if (e === 3) parent.abort()
+    },
+  })
+
+  expect(events).toEqual([1, 2, 3])
+  expect(captured?.aborted).toBe(true)
+})
+
+test("runSseAttempt calls onOpen after the stream opens", async () => {
+  const order: string[] = []
+  await runSseAttempt<number>({
+    parentSignal: new AbortController().signal,
+    open: async () => {
+      order.push("open")
+      return { stream: streamOf([1]) }
+    },
+    onOpen: () => {
+      order.push("onOpen")
+    },
+    onEvent: () => order.push("event"),
+  })
+  expect(order).toEqual(["open", "onOpen", "event"])
+})
+
+test("runSseAttempt balances parent-signal listeners across repeated attempts (no accumulation)", async () => {
+  // The original bug accumulated one un-removed AbortSignal.any listener on the
+  // long-lived signal per reconnect, tripping MaxListenersExceededWarning. The
+  // bridge must add AND remove its listener every attempt.
+  let adds = 0
+  let removes = 0
+  const fakeParent = {
+    aborted: false,
+    addEventListener: () => {
+      adds++
+    },
+    removeEventListener: () => {
+      removes++
+    },
+  } as unknown as AbortSignal
+
+  for (let i = 0; i < 5; i++) {
+    await runSseAttempt<number>({
+      parentSignal: fakeParent,
+      open: async () => ({ stream: streamOf([1]) }),
+      onEvent: () => {},
+    })
+  }
+
+  expect(adds).toBe(5)
+  expect(removes).toBe(5)
+})
