+      // false-fail. A gap ratio would be the more direct statement of "exponential",
+      // but its worst-case clean margin is only ~1.53 against a ~1.4 threshold, and a
+      // single asymmetric ~800ms stall on the FIRST gap flips it — a flaky release
+      // gate is worse than a slightly less pointed assertion.
+      expect(gaps[2]!).toBeGreaterThan(3000)
+    } finally {
+      app.renderer.destroy()
+      if (previous.minOpen === undefined) delete process.env.OPENCODE_SSE_MIN_OPEN_MS
+      else process.env.OPENCODE_SSE_MIN_OPEN_MS = previous.minOpen
+      if (previous.max === undefined) delete process.env.OPENCODE_RECONCILE_MAX_FAILURES
+      else process.env.OPENCODE_RECONCILE_MAX_FAILURES = previous.max
+    }
+  },
+  40000,
+)
+
+test(
+  "a degraded episode SELF-HEALS via the slow-cadence forced reconnect, and re-arms the toast latch",
+  async () => {
+    // Spec item 3: recovery from degraded is a full RECONNECT, not a periodic
+    // re-fetch — a re-fetch would run concurrently with the live pump and break the
+    // "injects strictly precede pumped events" ordering. Nothing else can trigger a
+    // reconnect here (the stream never errors, the child set never changes), so if
+    // the degraded reconnect is not wired the pending prompt below NEVER lands.
+    const previous = {
+      retry: process.env.OPENCODE_RECONCILE_DEGRADED_RETRY_MS,
+      timeout: process.env.OPENCODE_RECONCILE_TIMEOUT_MS,
+    }
+    process.env.OPENCODE_RECONCILE_DEGRADED_RETRY_MS = "200"
+    process.env.OPENCODE_RECONCILE_TIMEOUT_MS = "500"
+    const pending = {
+      id: "per_after_heal",
+      sessionID,
+      permission: "bash",
+      patterns: ["ls"],
+      metadata: {},
+      always: [],
+    }
+    // Broken for exactly the 3 attempts it takes to degrade, healthy afterwards.
+    const d = door({
+      permissions: (attempt) => (attempt <= 3 ? json({ error: "bad gateway" }, { status: 502 }) : json([pending])),
+    })
+    const { app, events, toasts } = await mount(d)
+    try {
+      await wait(() => toasts.length >= 1)
+      expect(d.permissionAttempts).toBe(3)
+      const opensWhenDegraded = d.eventOpens.length
+
+      // The forced reconnect (detected on the next child poll tick) re-runs the
+      // reconcile in the safe pre-pump position, and it succeeds.
+      await wait(() => events.some((e) => seen(e).propertyID === pending.id), 25000)
+      expect(d.permissionAttempts).toBeGreaterThanOrEqual(4)
+      // It really was a RECONNECT, not an in-place re-fetch.
+      expect(d.eventOpens.length).toBeGreaterThan(opensWhenDegraded)
+      // Exactly one toast for the whole episode.
+      expect(toasts).toEqual([DEGRADED_TOAST])
+    } finally {
+      app.renderer.destroy()
+      if (previous.retry === undefined) delete process.env.OPENCODE_RECONCILE_DEGRADED_RETRY_MS
+      else process.env.OPENCODE_RECONCILE_DEGRADED_RETRY_MS = previous.retry
+      if (previous.timeout === undefined) delete process.env.OPENCODE_RECONCILE_TIMEOUT_MS
+      else process.env.OPENCODE_RECONCILE_TIMEOUT_MS = previous.timeout
+    }
+  },
+  40000,
+)
+
+test(
+  "(c) a dead child session's failed reconcile does not swallow its healthy parent's pending prompt",
+  async () => {
+    // The reconcile fans out over {active} U live children, and Session.children()
+    // has no liveness filter, so a gone/unroutable child is a permanent 404 while
+    // the parent is perfectly healthy. Under Promise.all the child's INSTANT
+    // rejection returns the await immediately, the attempt is torn down, and the
+    // parent's still-in-flight read is aborted with it — the parent's pending
+    // prompt is never injected on ANY attempt. allSettled lets every sibling finish
+    // first, so the parent's prompt lands even though the attempt is reported failed.
+    const parentPending = {
+      id: "per_parent",
+      sessionID,
+      permission: "bash",
+      patterns: ["ls"],
+      metadata: {},
+      always: [],
+    }
+    const child = { id: "ses_child", parentID: sessionID, time: { created: 1, updated: 2 } }
+    let parentReads = 0
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = new URL(input instanceof Request ? input.url : String(input))
+      const signal = input instanceof Request ? input.signal : init?.signal
+      if (url.pathname === "/event")
+        return new Response(new ReadableStream<Uint8Array>({ start() {} }), {
+          headers: { "content-type": "text/event-stream" },
+        })
+      if (url.pathname === `/session/${sessionID}/children`) return json([child])
+      // The CHILD is permanently gone and fails INSTANTLY.
+      if (url.pathname.startsWith(`/session/${child.id}/`)) return json({ error: "gone" }, { status: 404 })
+      if (url.pathname === `/session/${sessionID}/permissions`) {
+        parentReads += 1
+        // Slower than the child's failure, and genuinely cancellable — exactly the
+        // shape a real HTTP read has.
+        const first = parentReads === 1
+        await new Promise<void>((resolve, reject) => {
+          const timer = setTimeout(resolve, 60)
+          signal?.addEventListener("abort", () => {
+            clearTimeout(timer)
+            reject(new Error("aborted"))
+          })
+        })
+        // Nothing pending until the child is in scope, so the ONLY way this prompt
+        // can land is on an attempt that also reconciles the dead child.
+        return json(first ? [] : [parentPending])
+      }
+      if (url.pathname.endsWith("/questions")) return json([])
+      return json({})
+    }) as typeof globalThis.fetch
+
+    const { app, events } = await mount({ fetch: fetchImpl })
+    try {
+      await wait(() => events.some((e) => seen(e).propertyID === parentPending.id), 25000)
+    } finally {
+      app.renderer.destroy()
+    }
+  },
+  40000,
+)
