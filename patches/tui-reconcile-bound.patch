+/** @jsxImportSource @opentui/solid */
+import { expect, test } from "bun:test"
+import { testRender } from "@opentui/solid"
+import type { GlobalEvent } from "@opencode-ai/sdk/v2"
+import { createEffect, onMount } from "solid-js"
+import { SDKProvider, useSDK } from "../../../src/context/sdk"
+import { useToast } from "../../../src/ui/toast"
+import { directory, json } from "../../fixture/tui-sdk"
+import { TestTuiContexts } from "../../fixture/tui-environment"
+
+// Part B (bead workstation-fdb1) WIRING proof. test/util/reconcile.test.ts pins the
+// guard's decision logic in isolation; this file pins that context/sdk.tsx actually
+// USES it, end to end through the real SSE reconnect loop:
+//
+//   before Part B: a PERSISTENT reconcile error threw out of onOpen on EVERY
+//   attempt, and the throw ended the attempt BEFORE the `for await` pump started.
+//   Reconnect -> same error -> forever. Zero events were ever delivered: a TUI
+//   frozen on a spinner until an operator restarted the serve pool.
+//
+//   after Part B: the 3rd consecutive failure proceeds degraded, the pump starts,
+//   live events flow, and the user gets one toast.
+
+const sessionID = "ses_root"
+
+const DEGRADED_TOAST = "Pending requests unavailable - retrying in background"
+
+async function wait(fn: () => boolean, timeout = 15000) {
+  const start = Date.now()
+  while (!fn()) {
+    if (Date.now() - start > timeout) throw new Error("timed out waiting for condition")
+    await Bun.sleep(10)
+  }
+}
+
+/** A fake front door. Serves a fresh SSE stream per /event subscribe and lets the
+ * test decide, per attempt, whether the pending-permission read succeeds. */
+function door(opts: { permissions: (attempt: number, signal?: AbortSignal | null) => Response | Promise<Response> }) {
+  const permissionCalls: number[] = []
+  const eventOpens: string[] = []
+  let live: ReadableStreamDefaultController<Uint8Array> | undefined
+
+  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = new URL(input instanceof Request ? input.url : String(input))
+    const signal = input instanceof Request ? input.signal : init?.signal
+    if (url.pathname === "/event") {
+      eventOpens.push(url.searchParams.get("session_ids") ?? "")
+      return new Response(
+        new ReadableStream<Uint8Array>({
+          start(controller) {
+            live = controller
+          },
+          cancel() {
+            live = undefined
+          },
+        }),
+        { headers: { "content-type": "text/event-stream", "cache-control": "no-cache" } },
+      )
+    }
+    if (url.pathname.endsWith("/permissions")) {
+      permissionCalls.push(Date.now())
+      return opts.permissions(permissionCalls.length, signal)
+    }
+    if (url.pathname.endsWith("/questions")) return json([])
+    if (url.pathname.endsWith("/children")) return json([])
+    return json({})
+  }) as typeof globalThis.fetch
+
+  return {
+    fetch: fetchImpl,
+    get permissionAttempts() {
+      return permissionCalls.length
+    },
+    eventOpens,
+    emit(payload: unknown) {
+      if (!live) throw new Error("no live event stream")
+      live.enqueue(new TextEncoder().encode(`data: ${JSON.stringify(payload)}\n\n`))
+    },
+    get streamOpen() {
+      return live !== undefined
+    },
+  }
+}
+
+/** Narrow view of the delivered `GlobalEvent` envelope. The payload is a large
+ * discriminated union and `wrap()` synthesizes members of it, so the tests read the
+ * two fields they care about through one shared accessor instead of casting inline. */
+function seen(event: GlobalEvent) {
+  const payload = event.payload as { id?: string; type?: string; properties?: { id?: string } }
+  return { id: payload.id, type: payload.type, propertyID: payload.properties?.id }
+}
+
+async function mount(d: { fetch: typeof globalThis.fetch }) {
+  const events: GlobalEvent[] = []
+  const toasts: string[] = []
+  let ready!: () => void
+  const mounted = new Promise<void>((resolve) => {
+    ready = resolve
+  })
+
+  function Probe() {
+    const sdk = useSDK()
+    const toast = useToast()
+    createEffect(() => {
+      const current = toast.currentToast
+      if (current) toasts.push(current.message)
+    })
+    onMount(() => {
+      sdk.event.on("event", (event) => events.push(event))
+      ready()
+    })
+    return <box />
+  }
+
+  const app = await testRender(() => (
+    <TestTuiContexts>
+      <SDKProvider url="http://door.test" sessionID={sessionID} directory={directory} fetch={d.fetch}>
+        <Probe />
+      </SDKProvider>
+    </TestTuiContexts>
+  ))
+  await mounted
+  return { app, events, toasts }
+}
