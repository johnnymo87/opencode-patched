+      // Every /event subscribe stayed session-scoped (no fallback to the firehose).
+      expect(d.eventOpens.every((ids) => ids === sessionID)).toBe(true)
+      // ...and it degraded at 3, not later: no runaway reconnect loop.
+      expect(d.permissionAttempts).toBe(3)
+    } finally {
+      app.renderer.destroy()
+    }
+  },
+  30000,
+)
