+++ b/packages/tui/test/cli/cmd/tui/bootstrap-settled.test.tsx
@@ -0,0 +1,43 @@
+/** @jsxImportSource @opentui/solid */
+import { expect, test } from "bun:test"
+import { mount } from "./sync-fixture"
+
+// Part B (bead workstation-fdb1). bootstrap()'s non-blocking phase fired 11 reads
+// under a single Promise.all whose .then set status to "complete". One rejection
+// therefore (a) stranded status at "partial" forever — and app.tsx gates the
+// `--session --fork` auto-fork on status === "complete", so `--session X --fork`
+// silently never forked — and (b) became an UNHANDLED promise rejection, because
+// that promise is `void`ed rather than returned into bootstrap's .catch.
+//
+// `mount()` itself waits for status === "complete", so this test's assertion is
+// mostly "mount does not time out".
+test("one failing non-blocking bootstrap read still completes the bootstrap", async () => {
+  const { app, sync } = await mount((url) => {
+    // A rejecting fetch, not an HTTP error: none of these reads uses throwOnError,
+    // so only a transport-level failure (or a hang) can reject them — which is
+    // exactly the shape that stranded status in production.
+    if (url.pathname === "/vcs") throw new Error("vcs read failed")
+    return undefined
+  })
+  try {
+    expect(sync.status).toBe("complete")
+    // The siblings still applied their own results.
+    expect(sync.data.command).toEqual([])
+    expect(sync.data.lsp).toEqual([])
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("several failing non-blocking bootstrap reads still complete the bootstrap", async () => {
+  const { app, sync } = await mount((url) => {
+    if (["/vcs", "/command", "/session/status"].includes(url.pathname)) throw new Error(`${url.pathname} failed`)
+    return undefined
+  })
+  try {
+    expect(sync.status).toBe("complete")
+    expect(sync.data.lsp).toEqual([])
+  } finally {
+    app.renderer.destroy()
+  }
+})
