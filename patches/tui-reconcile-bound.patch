+      await wait(() => d.streamOpen)
+      d.emit({ id: "evt_live", type: "session.idle", properties: { sessionID } })
+      // THE un-brick: before Part B this never arrived, no matter how long you waited.
+      await wait(() => events.some((e) => seen(e).id === "evt_live"))
