+test(
+  "(a) a PERSISTENT reconcile failure proceeds degraded after 3 attempts: the pump starts and one toast fires",
+  async () => {
+    const d = door({ permissions: () => json({ error: "bad gateway" }, { status: 502 }) })
+    const { app, events, toasts } = await mount(d)
+    try {
+      // 3 consecutive failures (attempts 1 and 2 ride the ~1s/~2s backoff).
+      await wait(() => d.permissionAttempts >= 3)
+      // Proceed-degraded: the stream from attempt 3 stays open and PUMPS.
+      await wait(() => toasts.length >= 1)
+      expect(toasts[0]).toBe(DEGRADED_TOAST)
