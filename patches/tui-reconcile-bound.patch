index 0000000..0692320
--- /dev/null
+++ b/packages/tui/test/util/reconcile.test.ts
@@ -0,0 +1,257 @@
+import { expect, test } from "bun:test"
+import { createReconcileGuard, reconcileDeadline, resolveMaxFailures, resolveMs, settleAll } from "../../src/util/reconcile"
+
+// Part B (bead workstation-fdb1). These tests pin the BOUND on the TUI's
+// fetch-on-reconnect reconcile. Before Part B, `reconcilePending` threw on ANY
+// error and the throw ended the SSE attempt BEFORE the event pump started, so a
+// PERSISTENT error (a door 502, a dead child session, a hung request) produced an
+// infinite reconnect loop and a permanently frozen TUI.
+
+function guardWith(overrides?: Parameters<typeof createReconcileGuard>[0]) {
+  const failed: { error: unknown; failures: number; degraded: boolean; first: boolean }[] = []
+  const recovered: number[] = []
+  let clock = 0
+  const guard = createReconcileGuard({
+    maxFailures: 3,
+    degradedRetryMs: 1000,
+    now: () => clock,
+    onFailure: (error, ctx) => failed.push({ error, ...ctx }),
+    onRecovered: () => recovered.push(clock),
+    ...overrides,
+  })
+  return {
+    guard,
+    failed,
+    /** Only the degraded subset — the calls that carry a user-visible consequence. */
+    get degraded() {
+      return failed.filter((f) => f.degraded)
