+++ b/packages/tui/src/util/reconcile.ts
@@ -0,0 +1,242 @@
+/**
+ * Part B (bead workstation-fdb1): bound the TUI's fetch-on-reconnect reconcile so
+ * a PERSISTENT reconcile error can no longer brick the TUI.
+ *
+ * Background. `context/sdk.tsx` fetches the pending permission/question lists in
+ * `runSseAttempt`'s `onOpen` — i.e. AFTER the SSE response headers arrive but
+ * BEFORE the `for await` pump starts consuming events. That ordering is
+ * load-bearing: it guarantees every injected pending record is applied strictly
+ * before any live event, so a `permission.replied` that races the fetch can never
+ * be undone by a stale re-add. Throwing from `onOpen` ends the attempt, which
+ * makes the caller reconnect with backoff and retry the reconcile. For a
+ * TRANSIENT failure that is exactly right (a reconnect delivers only FUTURE
+ * events, so a prompt asked during the gap is lost, not late — retry is the only
+ * safe recovery).
+ *
+ * For a PERSISTENT failure it was catastrophic: throw -> attempt ends before the
+ * pump -> reconnect -> same failure -> infinite reconnect -> the TUI never pumps
+ * a single event. The user sees a session frozen on a spinner forever and the
+ * only way out is a serve-pool restart, which kills every other live session.
+ *
+ * The bound. Count CONSECUTIVE reconcile-attempt failures of ANY kind (there is
+ * deliberately NO transient/permanent taxonomy — misclassifying a permanent error
+ * as transient is exactly the bug, and misclassifying a transient one costs the
+ * whole point of the retry). After `maxFailures`, PROCEED-DEGRADED: swallow the
+ * error so the caller starts the event pump, notify the user once per episode, and
+ * let a slow-cadence forced reconnect (`shouldReconnect`) retry the reconcile in
+ * the same safe pre-pump position. Any successful reconcile ends the episode.
+ *
+ * What degraded actually costs, precisely — it is NARROWER than it sounds, and
+ * getting this wrong in either direction leads to mistuning the cadence below.
+ * While degraded AND connected, live `*.asked` events still flow through the pump
+ * normally; the reconcile only ever existed to cover the RECONNECT GAP. So the loss
+ * is exactly: a prompt asked during a gap stays invisible until the next successful
+ * reconcile. Bounded, notified, and self-healing — as opposed to an unbounded,
+ * invisible, operator-only-recoverable freeze in which NOTHING renders at all.
+ *
+ * KNOWN STEADY STATE, not a bug: `settleAll` reports the batch failed if ANY
+ * session in it failed, and only a fully clean batch clears the episode. A child
+ * session that is permanently gone (Session.children() has no liveness filter, and
+ * a storage-missing session is a deterministic 404) therefore pins an otherwise
+ * healthy TUI in degraded state indefinitely — one forced reconnect every
+ * `degradedRetryMs`, forever. That is still strictly better than the freeze it
+ * replaces (the healthy sessions' prompts DO land, because settleAll lets every
+ * sibling finish), and it follows from the approved spec's "the counter reflects the
+ * attempt as a whole". Recovering on "the ACTIVE session's own reads succeeded", or
+ * pruning definitively-not-found children from the set, is the fix; it is a spec
+ * change and is tracked separately. Do not "simplify" this into silent per-session
+ * failure swallowing — that is the fail-open hole this whole file exists to avoid.
+ */
+
+const num = (value: string | undefined) => {
+  if (value === undefined || value === "") return Number.NaN
+  return Number(value)
+}
+
+/** Positive integer or fallback. Rejects 0/negative/NaN: `OPENCODE_RECONCILE_MAX_FAILURES=0`
+ * would make `failures < max` false on the FIRST failure, i.e. degrade instantly with
+ * zero retry budget, silently discarding the transient-recovery behavior. */
+export function resolveMaxFailures(value: string | undefined, fallback: number) {
+  const n = num(value)
+  return Number.isInteger(n) && n > 0 ? n : fallback
+}
+
+/** Positive duration or fallback. Same reasoning: 0 must not mean "immediately". */
+export function resolveMs(value: string | undefined, fallback: number) {
+  const n = num(value)
+  return Number.isFinite(n) && n > 0 ? n : fallback
+}
+
+const env = (name: string) => (typeof process !== "undefined" ? process.env?.[name] : undefined)
+
+/** Consecutive failed reconcile attempts tolerated before proceeding degraded.
+ * Override with OPENCODE_RECONCILE_MAX_FAILURES. 3 rides the SSE loop's existing
+ * ~1s + ~2s jittered backoff, so a genuinely transient blip still recovers with a
+ * full reconcile. */
+export const RECONCILE_MAX_FAILURES_DEFAULT = 3
+
+/** How long to stay degraded before forcing a full reconnect to retry the
+ * reconcile. Override with OPENCODE_RECONCILE_DEGRADED_RETRY_MS. A full reconnect
+ * (not a periodic re-fetch) is deliberate: a re-fetch concurrent with the running
+ * event pump would break the "injects strictly precede pumped events" ordering
+ * above, while a reconnect re-runs the reconcile in the safe pre-pump position for
+ * free.
+ *
+ * The cadence is slow because a reconnect is not free — `/event` has no replay, so
+ * a reconnect drops whatever was published in its gap. But that gap is SMALLER than
+ * it looks: the server registers its event listener eagerly, before the response
+ * body fiber starts, into an unbounded queue (see the "Listener registration is
+ * eager" comment in server/.../handlers/event.ts), so the loss window is only
+ * abort -> new-subscribe-headers — sub-second on a door that can accept
+ * connections — NOT the whole reconcile. The fork already reconnects on every
+ * child-set change via the ~5s drift poll, so one extra reconnect per few minutes
+ * is marginal against that baseline. */
+export const RECONCILE_DEGRADED_RETRY_DEFAULT_MS = 180_000
+
+/** Default deadline for one whole reconcile batch. Override with
+ * OPENCODE_RECONCILE_TIMEOUT_MS. Generous: the pending lists are an in-memory
+ * filter server-side, so 10s is far beyond any healthy response. */
+export const RECONCILE_TIMEOUT_DEFAULT_MS = 10_000
+
+/**
+ * The combined abort signal for ONE reconcile batch: the caller's per-attempt
+ * signal plus a deadline.
+ *
+ * CRITICAL — without the deadline the whole bound below is defeated. The SDK's
+ * default fetch sets `req.timeout = false` (packages/sdk/js/src/v2/client.ts) and
+ * `opencode attach` passes no fetch override, so a HUNG read never resolves, never
+ * rejects, and therefore never counts as a failure: `await onOpen` hangs forever,
+ * the event pump never starts, and no number of retries is ever attempted. A hang
+ * is a more likely real-world shape than a clean 502 (a wedged serve, a door
+ * waiting on an unresponsive upstream), so it MUST be converted into a countable
+ * rejection.
+ *
+ * ONE `AbortSignal.any` per batch, shared by every request in it — not one per
+ * request. Chaining an `any` per request off the attempt signal is precisely the
+ * listener-accumulation shape that produced MaxListenersExceededWarning in bead
+ * workstation-lyj0.
+ *
+ * `ms` is read lazily rather than captured at module load so it stays tunable at
+ * runtime (and injectable from tests).
+ */
+export function reconcileDeadline(parentSignal?: AbortSignal, ms?: number): AbortSignal {
+  const timeout = AbortSignal.timeout(ms ?? resolveMs(env("OPENCODE_RECONCILE_TIMEOUT_MS"), RECONCILE_TIMEOUT_DEFAULT_MS))
+  return parentSignal ? AbortSignal.any([parentSignal, timeout]) : timeout
+}
+
+export type ReconcileFailureContext = {
+  /** Consecutive failed attempts, including this one. */
+  failures: number
+  /** False while retry budget remains (this failure is about to be rethrown so the
+   * caller reconnects); true once the budget is spent and the caller will proceed. */
+  degraded: boolean
+  /** True only on the FIRST degraded attempt of an episode — the one-toast-per-episode
+   * latch. Always false while `degraded` is false. */
+  first: boolean
+}
+
+export type ReconcileGuard = {
+  /**
+   * Run one reconcile attempt. Rethrows while there is retry budget left (the
+   * caller must end the SSE attempt and reconnect); resolves once the budget is
+   * spent (the caller must proceed and start the event pump).
+   *
+   * `signal` is the attempt's abort signal. A rejection observed after it aborted
+   * is TEARDOWN (session switch, provider cleanup), not a reconcile failure, and
+   * must not be counted — otherwise switching sessions on a healthy door walks the
+   * counter toward a bogus degraded episode.
+   */
+  run(attempt: () => Promise<void>, signal?: AbortSignal): Promise<void>
+  /** True when a degraded episode has lasted long enough to warrant a forced reconnect. */
+  shouldReconnect(): boolean
+  readonly degraded: boolean
+  readonly failures: number
+}
+
+export function createReconcileGuard(opts?: {
+  maxFailures?: number
+  degradedRetryMs?: number
+  now?: () => number
+  /** Called on EVERY counted failure, degraded or not. Pre-degrade failures are
+   * otherwise completely invisible — runSseAttempt swallows the rethrow and the
+   * startSSE loop has a bare `.catch(() => {})` — so a recurring 2-failure blip
+   * would leave no trace at all. Log every call; toast only when `first`. */
+  onFailure?: (error: unknown, ctx: ReconcileFailureContext) => void
+  /** Called on the first successful reconcile that ends a degraded episode. */
+  onRecovered?: () => void
+}): ReconcileGuard {
+  // Env resolved at construction (once per SDKProvider), not at module load, so the
+  // knobs stay tunable at runtime and injectable from tests.
+  const maxFailures =
+    opts?.maxFailures ?? resolveMaxFailures(env("OPENCODE_RECONCILE_MAX_FAILURES"), RECONCILE_MAX_FAILURES_DEFAULT)
+  const degradedRetryMs =
+    opts?.degradedRetryMs ??
+    resolveMs(env("OPENCODE_RECONCILE_DEGRADED_RETRY_MS"), RECONCILE_DEGRADED_RETRY_DEFAULT_MS)
+  const now = opts?.now ?? (() => Date.now())
+
+  let failures = 0
+  // When the CURRENT degraded attempt proceeded. undefined <=> not degraded.
+  let degradedSince: number | undefined
+  // One notification per episode; cleared only by a successful reconcile.
+  let notified = false
+
+  return {
+    async run(attempt: () => Promise<void>, signal?: AbortSignal) {
+      try {
+        await attempt()
+      } catch (error) {
+        if (signal?.aborted) throw error
+        failures += 1
+        // NOTE: `failures` is intentionally NOT reset when degrading. Once an
+        // episode is open, every subsequent failed attempt degrades immediately
+        // rather than spending another retry budget — the door is already known
+        // sick, and re-spending the budget would mean another 3 frozen attempts
+        // per forced reconnect.
+        if (failures < maxFailures) {
+          opts?.onFailure?.(error, { failures, degraded: false, first: false })
+          throw error
+        }
+        degradedSince = now()
+        const first = !notified
+        notified = true
+        opts?.onFailure?.(error, { failures, degraded: true, first })
+        return
+      }
+      const wasDegraded = degradedSince !== undefined
+      failures = 0
+      degradedSince = undefined
+      notified = false
+      if (wasDegraded) opts?.onRecovered?.()
+    },
+    shouldReconnect() {
+      if (degradedSince === undefined) return false
+      return now() - degradedSince >= degradedRetryMs
+    },
+    get degraded() {
+      return degradedSince !== undefined
+    },
+    get failures() {
+      return failures
+    },
+  }
+}
+
+/**
+ * `Promise.allSettled` semantics with a rethrow: every task runs to completion,
+ * and the batch as a whole is reported failed if any task failed.
+ *
+ * Why not `Promise.all`: `Promise.all` does not cancel siblings, but it DOES
+ * return at the first rejection — so the caller tears the SSE attempt down while
+ * sibling injects are still in flight, and those injects land outside the
+ * "strictly before the event pump" window the reconcile ordering depends on. It
+ * also means one dead child session fails the reconcile for its healthy parent.
+ * `allSettled` closes both by construction while still reporting "the attempt as a
+ * whole failed" to the bound above.
+ */
+export async function settleAll(tasks: Iterable<Promise<unknown>>): Promise<void> {
+  const results = await Promise.allSettled(tasks)
+  const reasons = results.filter((r) => r.status === "rejected").map((r) => (r as PromiseRejectedResult).reason)
+  if (reasons.length === 0) return
+  if (reasons.length === 1) throw reasons[0]
+  throw new AggregateError(reasons, `${reasons.length} of ${results.length} reconcile fetches failed`)
+}
