 describe("util.session", () => {
   test("recognizes generated parent and child titles", () => {
@@ -7,4 +7,58 @@ describe("util.session", () => {
     expect(isDefaultTitle("Child session - 2026-06-06T12:34:56.789Z")).toBeTrue()
     expect(isDefaultTitle("New session - custom")).toBeFalse()
   })
+
+  describe("resolveRootSessionID", () => {
+    test("returns undefined for undefined sessionID", () => {
+      expect(resolveRootSessionID({ get: () => undefined }, undefined)).toBeUndefined()
+    })
+
+    test("returns root sessionID when session has no parentID", () => {
+      const store = {
+        get: (id: string) => (id === "root-1" ? { id: "root-1" } : undefined),
+      }
+      expect(resolveRootSessionID(store, "root-1")).toBe("root-1")
+    })
+
+    test("resolves 1-level child to root sessionID", () => {
+      const sessions: Record<string, { id: string; parentID?: string }> = {
+        "child-1": { id: "child-1", parentID: "root-1" },
+        "root-1": { id: "root-1" },
+      }
+      const store = { get: (id: string) => sessions[id] }
+      expect(resolveRootSessionID(store, "child-1")).toBe("root-1")
+    })
+
+    test("resolves multi-level nested subagent session to root sessionID", () => {
+      const sessions: Record<string, { id: string; parentID?: string }> = {
+        "subchild-1": { id: "subchild-1", parentID: "child-1" },
+        "child-1": { id: "child-1", parentID: "root-1" },
+        "root-1": { id: "root-1" },
+      }
+      const store = { get: (id: string) => sessions[id] }
+      expect(resolveRootSessionID(store, "subchild-1")).toBe("root-1")
+    })
+
+    test("falls back to parentID if parent session object is missing from store", () => {
+      const sessions: Record<string, { id: string; parentID?: string }> = {
+        "child-1": { id: "child-1", parentID: "root-missing" },
+      }
+      const store = { get: (id: string) => sessions[id] }
+      expect(resolveRootSessionID(store, "child-1")).toBe("root-missing")
+    })
+
+    test("falls back to given sessionID if session is missing from store", () => {
+      const store = { get: () => undefined }
+      expect(resolveRootSessionID(store, "unknown-session")).toBe("unknown-session")
+    })
+
+    test("handles circular parentID references gracefully", () => {
+      const sessions: Record<string, { id: string; parentID?: string }> = {
+        "s-1": { id: "s-1", parentID: "s-2" },
+        "s-2": { id: "s-2", parentID: "s-1" },
+      }
+      const store = { get: (id: string) => sessions[id] }
+      expect(resolveRootSessionID(store, "s-1")).toBeDefined()
+    })
+  })
 })
