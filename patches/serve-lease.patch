+import { describe, expect, test } from "bun:test";
+import path from "node:path";
+import { createHash } from "node:crypto";
+import { tmpdir } from "../fixture/tmpdir";
+import { openRoutingLeaseDb, SchemaMismatchError, getRoutingDbPath, EXPECTED_DDL_CHECKSUM, getSharedRoutingLease, __resetSharedRoutingLease, getSelfIdentity, setSelfIdentity } from "../../src/serve/routing-lease";
+import { Flag } from "../../src/flag/flag";
+
+const ROUTING_DDL = `
+  CREATE TABLE IF NOT EXISTS serve_instance (
+    serve_id       TEXT PRIMARY KEY,
+    instance_uuid  TEXT NOT NULL,
+    endpoint       TEXT NOT NULL,
+    binary_epoch   INTEGER NOT NULL DEFAULT 0,
+    health_state   TEXT NOT NULL DEFAULT 'unknown',  -- healthy | unhealthy | unknown
+    heartbeat_at   INTEGER NOT NULL,
+    draining       INTEGER NOT NULL DEFAULT 0
+  );
+
+  CREATE TABLE IF NOT EXISTS session_assignment (
+    session_id        TEXT PRIMARY KEY,
+    directory_key     TEXT,
+    desired_serve_id  TEXT NOT NULL,
+    owner_generation  INTEGER NOT NULL DEFAULT 1,
+    state             TEXT NOT NULL DEFAULT 'assigned', -- assigned|draining|dormant|migrating
+    last_active_at    INTEGER NOT NULL,
+    updated_at        INTEGER NOT NULL
+  );
+  CREATE INDEX IF NOT EXISTS idx_assignment_serve ON session_assignment(desired_serve_id, state);
+
+  CREATE TABLE IF NOT EXISTS session_lease (
+    session_id        TEXT PRIMARY KEY,
+    serve_id          TEXT NOT NULL,
+    instance_uuid     TEXT NOT NULL,
+    owner_generation  INTEGER NOT NULL,
+    lease_expires_at  INTEGER NOT NULL,
+    heartbeat_at      INTEGER NOT NULL,
+    binary_epoch      INTEGER NOT NULL DEFAULT 0
+  );
+  CREATE INDEX IF NOT EXISTS idx_lease_serve ON session_lease(serve_id);
+  CREATE INDEX IF NOT EXISTS idx_lease_expiry ON session_lease(lease_expires_at);
+
+  CREATE TABLE IF NOT EXISTS routing_meta (
+    id INTEGER PRIMARY KEY CHECK (id = 1),
+    schema_version INTEGER NOT NULL,
+    ddl_checksum   TEXT NOT NULL,
+    binary_epoch   INTEGER NOT NULL,
+    updated_at     INTEGER NOT NULL
+  );
+`;
+
+const TEST_DDL_CHECKSUM = createHash("sha256").update(ROUTING_DDL).digest("hex");
+
+function initDatabaseSchema(db: any) {
+  db.run(ROUTING_DDL);
+  db.run(
+    "INSERT OR IGNORE INTO routing_meta (id, schema_version, ddl_checksum, binary_epoch, updated_at) VALUES (1, 1, ?, 0, ?)",
+    [TEST_DDL_CHECKSUM, Date.now()]
+  );
+}
+
+describe("Routing Lease Adapter", () => {
+  test("1. acquire happy path", async () => {
+    await using tmp = await tmpdir();
+    const dbFile = path.join(tmp.path, "routing.db");
+    
+    // Set the env/flag to point to our temp DB
+    const originalFlag = Flag.OPENCODE_ROUTING_DB;
+    process.env.OPENCODE_ROUTING_DB = dbFile;
+    (Flag as any).OPENCODE_ROUTING_DB = dbFile;
+
+    try {
+      // First, create and seed schema
+      const { Database } = await import("bun:sqlite");
+      const seedDb = new Database(dbFile);
+      initDatabaseSchema(seedDb);
+
+      const now = Date.now();
+      const serveId = "serve-1";
+      const sessionId = "session-1";
+      const instanceUuid = "uuid-1";
+
+      // Seed serve_instance and session_assignment
+      seedDb.run(
+        "INSERT INTO serve_instance (serve_id, instance_uuid, endpoint, heartbeat_at) VALUES (?, ?, ?, ?)",
+        [serveId, instanceUuid, "http://localhost:1234", now]
+      );
+      seedDb.run(
+        "INSERT INTO session_assignment (session_id, desired_serve_id, owner_generation, state, last_active_at, updated_at) VALUES (?, ?, 1, 'assigned', ?, ?)",
+        [sessionId, serveId, now, now]
+      );
+      seedDb.close();
+
+      // Open via adapter
+      const adapter = await openRoutingLeaseDb();
+      const res = await adapter.acquire({
+        sessionId,
+        serveId,
+        instanceUuid,
+        ttlMs: 5000,
+      });
+
+      expect(res.ok).toBe(true);
+      expect(res.assignmentExists).toBe(true);
+      expect(res.token).toEqual({
+        sessionId,
+        serveId,
+        instanceUuid,
+        ownerGeneration: 1,
+        binaryEpoch: 0,
+      });
+
+      // Verify DB row exists with exact token fields
+      const verifyDb = new Database(dbFile);
+      const row = verifyDb.prepare("SELECT * FROM session_lease WHERE session_id = ?").get(sessionId) as any;
+      expect(row).toBeDefined();
+      expect(row.serve_id).toBe(serveId);
+      expect(row.instance_uuid).toBe(instanceUuid);
+      expect(row.owner_generation).toBe(1);
+      expect(row.binary_epoch).toBe(0);
+      expect(row.lease_expires_at).toBeGreaterThan(now + 4000);
+      verifyDb.close();
+      await adapter.close();
+    } finally {
+      process.env.OPENCODE_ROUTING_DB = originalFlag;
+      (Flag as any).OPENCODE_ROUTING_DB = originalFlag;
+    }
+  });
+
+  test("2. renew (full token) success, then fail-closed", async () => {
+    await using tmp = await tmpdir();
+    const dbFile = path.join(tmp.path, "routing.db");
+    
+    const originalFlag = Flag.OPENCODE_ROUTING_DB;
+    process.env.OPENCODE_ROUTING_DB = dbFile;
+    (Flag as any).OPENCODE_ROUTING_DB = dbFile;
+
+    try {
+      const { Database } = await import("bun:sqlite");
+      const seedDb = new Database(dbFile);
+      initDatabaseSchema(seedDb);
+
+      const now = Date.now();
+      const serveId = "serve-1";
+      const sessionId = "session-1";
+      const instanceUuid = "uuid-1";
+
+      seedDb.run(
+        "INSERT INTO session_assignment (session_id, desired_serve_id, owner_generation, state, last_active_at, updated_at) VALUES (?, ?, 1, 'assigned', ?, ?)",
+        [sessionId, serveId, now, now]
+      );
+      seedDb.close();
+
