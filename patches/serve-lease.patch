+        // Bump owner_generation but keep desired_serve_id pointing at THIS serve.
+        // This mimics benign generation churn (e.g. a reassign sweep that rendezvous
+        // re-picked the same serve): the next renew fails the CAS, but the assignment
+        // still belongs to us.
+        const modifyDb = new Database(tempDbPath)
+        modifyDb.run("UPDATE session_assignment SET owner_generation = 2 WHERE session_id = ?", [chat.id])
+        modifyDb.close()
+
+        // Fix D: the renewal fiber must re-acquire at the bumped generation rather
+        // than fail-closed. Wait for the lease row to be re-stamped at generation 2
+        // (the renewal interval is 10s).
+        const reacquired = yield* pollWithTimeout(
+          Effect.sync(() => {
+            const verifyDb = new Database(tempDbPath)
+            const row = verifyDb.prepare("SELECT * FROM session_lease WHERE session_id = ?").get(chat.id) as any
+            verifyDb.close()
+            return row && row.owner_generation === 2 ? row : undefined
+          }),
+          "lease was not re-acquired at the bumped generation",
+          "14 seconds"
+        )
+        expect(reacquired.serve_id).toBe(serveId)
+        expect(reacquired.instance_uuid).toBe(instanceUuid)
+
+        // Let the held LLM response complete; the run must finish normally (no fail-closed).
+        resolveWait()
+        const result = yield* Fiber.join(runFiber)
+        expect(result.info.role).toBe("assistant")
+
+        // Lease released on the rotated (generation 2) token after completion.
+        const verifyDb = new Database(tempDbPath)
+        const rowAfter = verifyDb.prepare("SELECT * FROM session_lease WHERE session_id = ?").get(chat.id)
+        verifyDb.close()
+        expect(rowAfter).toBeNull()
+      } finally {
+        process.env.OPENCODE_ROUTING_DB = originalFlag
+        ;(Flag as any).OPENCODE_ROUTING_DB = originalFlag
+        __resetSharedRoutingLease()
+        const fs = require("fs")
+        try { fs.unlinkSync(tempDbPath) } catch {}
+      }
+    }),
+  30_000,
