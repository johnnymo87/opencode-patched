+describe("leaseDeadlineExceeded", () => {
+  bunIt("should return false if state is null (routing off / no lease)", () => {
+    expect(leaseDeadlineExceeded(null, Date.now(), 5000)).toBe(false)
+  })
+
+  bunIt("should return true if state.lost is true", () => {
+    expect(leaseDeadlineExceeded({ validUntil: Date.now() + 10000, lost: true }, Date.now(), 5000)).toBe(true)
+  })
+
+  bunIt("should return true if now is past validUntil - margin", () => {
+    const validUntil = Date.now() + 4000
+    expect(leaseDeadlineExceeded({ validUntil, lost: false }, Date.now(), 5000)).toBe(true)
+  })
+
+  bunIt("should return true if now is exactly at validUntil - margin", () => {
+    const validUntil = Date.now() + 5000
+    expect(leaseDeadlineExceeded({ validUntil, lost: false }, Date.now(), 5000)).toBe(true)
+  })
+
+  bunIt("should return false if now is well before validUntil - margin", () => {
+    const validUntil = Date.now() + 10000
+    expect(leaseDeadlineExceeded({ validUntil, lost: false }, Date.now(), 5000)).toBe(false)
+  })
+
+})
