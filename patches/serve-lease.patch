@@ -0,0 +1,478 @@
+import { isAbsolute, join } from "node:path";
+import { Flag } from "../flag/flag";
+import { Global } from "../global";
+
+export const EXPECTED_SCHEMA_VERSION = 1;
+
+/**
+ * Expected SHA256 checksum of ROUTING_DDL.
+ * This is computed from the exact ROUTING_DDL template string in pigeon:
+ * /home/dev/projects/pigeon/packages/daemon/src/routing/route-schema.ts
+ */
+export const EXPECTED_DDL_CHECKSUM = "e5c8e4094735034be618553ee3594a26f20d06004902ed0da8f66dc25eef4a68";
+
+export class SchemaMismatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "SchemaMismatchError";
+  }
+}
+
+export interface LeaseToken {
+  sessionId: string;
+  serveId: string;
+  instanceUuid: string;
+  ownerGeneration: number;
+  binaryEpoch: number;
+}
+
+export interface AcquireResult {
+  ok: boolean;
+  token?: LeaseToken;
+  assignmentExists: boolean;
+}
+
+export interface RoutingLeaseDbAdapter {
+  acquire(options: {
+    sessionId: string;
+    serveId: string;
+    instanceUuid: string;
+    ttlMs: number;
+  }): Promise<AcquireResult>;
+
+  renew(token: LeaseToken, ttlMs: number): Promise<boolean>;
+
+  release(token: LeaseToken): Promise<boolean>;
+
+  readValid(sessionId: string, token: LeaseToken): Promise<boolean>;
+
+  registerSelf(options: {
+    serveId: string;
+    instanceUuid: string;
+    endpoint: string;
+  }): Promise<void>;
+
+  heartbeat(serveId: string): Promise<boolean>;
+
+  markDead(serveId: string): Promise<boolean>;
+
+  close(): Promise<void>;
+}
+
+/**
+ * Resolves the DB path from Flag.OPENCODE_ROUTING_DB.
+ * Matches absolute-vs-relative logic as Database.path() in packages/core/src/database/database.ts
+ */
+export function getRoutingDbPath(): string {
+  const dbVar = Flag.OPENCODE_ROUTING_DB;
+  if (!dbVar) {
+    throw new Error("OPENCODE_ROUTING_DB environment variable is not configured.");
+  }
+  if (dbVar === ":memory:" || isAbsolute(dbVar)) {
+    return dbVar;
+  }
+  return join(Global.Path.data, dbVar);
+}
+
+/**
+ * Utility helper to retry database operations on SQLITE_BUSY with jitter.
+ */
+async function withRetry<T>(fn: () => T, maxAttempts = 3): Promise<T> {
+  let attempt = 0;
+  while (true) {
+    try {
+      return fn();
+    } catch (error: any) {
+      attempt++;
+      const isBusy = error && (
+        error.code === "SQLITE_BUSY" || 
+        error.message?.includes("SQLITE_BUSY")
+      );
+      if (isBusy && attempt < maxAttempts) {
+        const delay = 50 + Math.random() * 100;
+        await new Promise((resolve) => setTimeout(resolve, delay));
+        continue;
+      }
+      throw error;
+    }
+  }
+}
+
+/**
+ * Maps standard camelCase parameters to both prefixed and non-prefixed styles
+ * to support both bun:sqlite and node:sqlite drivers seamlessly.
+ */
+function mapParams(params: Record<string, any>): Record<string, any> {
+  const mapped: Record<string, any> = {};
+  for (const [key, val] of Object.entries(params)) {
+    mapped[key] = val;
+    mapped[`@${key}`] = val;
+  }
+  return mapped;
+}
+
+/**
+ * Helper to build a unified database handle for both bun:sqlite and node:sqlite.
+ * This uses runtime detection + dynamic import of bun:sqlite / node:sqlite (rather than the
+ * repository's #sqlite Effect-layer subpath map) because we require a raw, named-parameter database
+ * handle rather than the standard Drizzle or Effect SQL clients.
+ * Note that the bun branch is the main production path (as opencode serve runs natively on Bun),
+ * while the node branch acts as a fallback.
+ */
+async function loadUnifiedDb(dbPath: string) {
+  const isBun = typeof process !== "undefined" && process.versions && process.versions.bun;
+
+  if (isBun) {
+    const { Database } = await import("bun:sqlite");
+    const nativeDb = new Database(dbPath);
+
+    return {
+      exec(sql: string) {
+        nativeDb.exec(sql);
+      },
+      prepare(sql: string) {
+        const stmt = nativeDb.prepare(sql);
+        return {
+          run(params?: Record<string, any>) {
+            const res = params ? stmt.run(mapParams(params)) : stmt.run();
+            return { changes: res.changes };
+          },
+          get(params?: Record<string, any>) {
+            const row = params ? stmt.get(mapParams(params)) : stmt.get();
+            return row === null ? undefined : row;
+          },
+          all(params?: Record<string, any>) {
+            return params ? stmt.all(mapParams(params)) : stmt.all();
+          }
+        };
+      },
+      close() {
+        nativeDb.close();
+      }
+    };
+  } else {
+    const { DatabaseSync } = await import("node:sqlite");
+    const nativeDb = new DatabaseSync(dbPath);
+
+    return {
+      exec(sql: string) {
+        nativeDb.exec(sql);
+      },
+      prepare(sql: string) {
+        const stmt = nativeDb.prepare(sql);
+        return {
+          run(params?: Record<string, any>) {
+            const res = params ? stmt.run(mapParams(params)) : stmt.run();
+            return { changes: res.changes };
+          },
+          get(params?: Record<string, any>) {
+            const row = params ? stmt.get(mapParams(params)) : stmt.get();
+            return row === null ? undefined : row;
+          },
+          all(params?: Record<string, any>) {
+            return params ? stmt.all(mapParams(params)) : stmt.all();
+          }
+        };
+      },
+      close() {
+        // node:sqlite DatabaseSync close is sync
+        nativeDb.close();
+      }
+    };
+  }
+}
+
+/**
+ * Connection opener that boots the routing DB and verifies the schema.
+ */
+export async function openRoutingLeaseDb(): Promise<RoutingLeaseDbAdapter> {
+  const dbPath = getRoutingDbPath();
+  const db = await loadUnifiedDb(dbPath);
+
+  try {
+    // Configure WAL and busy timeout on open
+    db.exec("PRAGMA journal_mode=WAL;");
+    db.exec("PRAGMA busy_timeout=2000;");
+
+    // Boot-assert schema check
+    let row: any;
+    try {
+      row = db.prepare("SELECT schema_version, ddl_checksum FROM routing_meta WHERE id = 1").get();
+    } catch (e: any) {
+      throw new SchemaMismatchError(`Failed to read routing_meta: ${e.message}`);
+    }
+
+    if (!row) {
+      throw new SchemaMismatchError("routing_meta singleton row (id=1) not found in routing database.");
+    }
+
+    if (row.schema_version !== EXPECTED_SCHEMA_VERSION || row.ddl_checksum !== EXPECTED_DDL_CHECKSUM) {
+      throw new SchemaMismatchError(
+        `Schema version or DDL checksum mismatch in routing database. ` +
+        `Expected version ${EXPECTED_SCHEMA_VERSION}, checksum ${EXPECTED_DDL_CHECKSUM}. ` +
+        `Got version ${row.schema_version}, checksum ${row.ddl_checksum}.`
+      );
+    }
+
+    // Pre-prepare our statements
+    const selectMetaStmt = db.prepare("SELECT binary_epoch FROM routing_meta WHERE id = 1");
+    const selectAssignmentStmt = db.prepare(
+      "SELECT owner_generation, desired_serve_id FROM session_assignment WHERE session_id = @sid"
+    );
+
+    const registerSelfStmt = db.prepare(
+      `INSERT INTO serve_instance
+         (serve_id, instance_uuid, endpoint, binary_epoch, health_state, heartbeat_at, draining)
+       VALUES (@serveId, @instanceUuid, @endpoint, @binaryEpoch, 'healthy', @heartbeatAt, 0)
+       ON CONFLICT(serve_id) DO UPDATE SET
+         instance_uuid = excluded.instance_uuid,
+         endpoint = excluded.endpoint,
+         binary_epoch = excluded.binary_epoch,
+         health_state = excluded.health_state,
+         heartbeat_at = excluded.heartbeat_at,
+         draining = excluded.draining`
+    );
+
+    const heartbeatStmt = db.prepare(
+      "UPDATE serve_instance SET heartbeat_at = @now, health_state = 'healthy' WHERE serve_id = @serveId"
+    );
+
+    const markDeadStmt = db.prepare(
+      "UPDATE serve_instance SET draining = 1 WHERE serve_id = @serveId"
+    );
+
+    const acquireCASStmt = db.prepare(
+      `INSERT INTO session_lease (session_id, serve_id, instance_uuid, owner_generation, lease_expires_at, heartbeat_at, binary_epoch)
+       SELECT @sid, @serve, @uuid, sa.owner_generation, @now + @ttlMs, @now, rm.binary_epoch
+       FROM session_assignment sa JOIN routing_meta rm ON rm.id = 1
+       WHERE sa.session_id=@sid AND sa.desired_serve_id=@serve AND sa.owner_generation=@gen AND rm.binary_epoch=@epoch
+       ON CONFLICT(session_id) DO UPDATE SET
+         serve_id=excluded.serve_id, instance_uuid=excluded.instance_uuid, owner_generation=excluded.owner_generation,
+         lease_expires_at=excluded.lease_expires_at, heartbeat_at=excluded.heartbeat_at, binary_epoch=excluded.binary_epoch
+       -- Re-validate the assignment+epoch invariant on conflict: the proposed (excluded.*) row
+       -- must still match the source-of-truth assignment and the current binary_epoch.
+       WHERE EXISTS (SELECT 1 FROM session_assignment sa JOIN routing_meta rm ON rm.id=1
+                     WHERE sa.session_id=excluded.session_id AND sa.desired_serve_id=excluded.serve_id
+                       AND sa.owner_generation=excluded.owner_generation AND rm.binary_epoch=excluded.binary_epoch)
+         -- Take-over ladder (only one branch need hold):
+         --   A: higher binary_epoch wins immediately (cutover; safe because M6 drains/stops old serves first).
+         AND ( session_lease.binary_epoch < excluded.binary_epoch
+               --   B: same epoch, higher generation wins (crash-reassignment).
+               OR (session_lease.binary_epoch = excluded.binary_epoch AND session_lease.owner_generation < excluded.owner_generation)
+               --   C: same epoch+generation, allowed only if the held lease has expired OR it's
+               --      the same owner (serve+instance) renewing its own lease (idempotent).
+               OR (session_lease.binary_epoch = excluded.binary_epoch AND session_lease.owner_generation = excluded.owner_generation
+                   AND (session_lease.lease_expires_at <= @now
+                        OR (session_lease.serve_id = excluded.serve_id AND session_lease.instance_uuid = excluded.instance_uuid))) )`
+    );
+
+    const renewCASStmt = db.prepare(
+      `UPDATE session_lease SET lease_expires_at=@now+@ttlMs, heartbeat_at=@now
+       WHERE session_id=@sid AND serve_id=@serve AND instance_uuid=@uuid AND owner_generation=@gen AND binary_epoch=@epoch
+         AND EXISTS (SELECT 1 FROM session_assignment sa JOIN routing_meta rm ON rm.id=1
+                     WHERE sa.session_id=@sid AND sa.desired_serve_id=@serve AND sa.owner_generation=@gen AND rm.binary_epoch=@epoch)`
+    );
+
+    const releaseStmt = db.prepare(
+      `DELETE FROM session_lease
+       WHERE session_id=@sid AND serve_id=@serve AND instance_uuid=@uuid AND owner_generation=@gen AND binary_epoch=@epoch`
+    );
+
+    const readValidStmt = db.prepare(
+      `SELECT 1 FROM session_lease sl
+       JOIN session_assignment sa ON sa.session_id = sl.session_id
+       JOIN routing_meta rm ON rm.id = 1
+       WHERE sl.session_id = @sid
+         AND sl.serve_id = @serve
+         AND sl.instance_uuid = @uuid
+         AND sl.owner_generation = @gen
+         AND sl.binary_epoch = @epoch
+         AND sl.lease_expires_at > @now
+         AND sl.owner_generation = sa.owner_generation
+         AND sl.serve_id = sa.desired_serve_id
+         AND sl.binary_epoch = rm.binary_epoch`
+    );
+
+    return {
+      async acquire(options) {
+        return withRetry(() => {
+          const now = Date.now();
+
+          // 2. Read owner_generation fresh from session_assignment
+          const assignmentRow: any = selectAssignmentStmt.get({ sid: options.sessionId });
+          const assignmentExists = !!assignmentRow && assignmentRow.desired_serve_id === options.serveId;
+
+          // 1. Read binary_epoch fresh from routing_meta
+          const metaRow: any = selectMetaStmt.get();
+          if (!metaRow) {
+            return { ok: false, assignmentExists };
+          }
+          const binaryEpoch = Number(metaRow.binary_epoch);
+
+          if (!assignmentRow) {
+            return { ok: false, assignmentExists };
+          }
+          const ownerGeneration = Number(assignmentRow.owner_generation);
+          const desiredServeId = assignmentRow.desired_serve_id;
+
+          // If the desired serve ID on assignment does not match our serveId, do not proceed.
+          if (desiredServeId !== options.serveId) {
+            return { ok: false, assignmentExists };
+          }
+
+          // 3. Execute acquireCAS statement
+          const params = {
+            sid: options.sessionId,
+            serve: options.serveId,
+            uuid: options.instanceUuid,
+            gen: ownerGeneration,
+            epoch: binaryEpoch,
+            now,
+            ttlMs: options.ttlMs,
+          };
+
+          const res = acquireCASStmt.run(params);
+          if (res.changes > 0) {
+            return {
+              ok: true,
+              assignmentExists,
+              token: {
+                sessionId: options.sessionId,
+                serveId: options.serveId,
+                instanceUuid: options.instanceUuid,
+                ownerGeneration,
+                binaryEpoch,
+              },
+            };
+          }
+
+          return { ok: false, assignmentExists };
+        });
+      },
+
+      async renew(token, ttlMs) {
+        return withRetry(() => {
+          const now = Date.now();
+          const params = {
+            sid: token.sessionId,
+            serve: token.serveId,
+            uuid: token.instanceUuid,
+            gen: token.ownerGeneration,
+            epoch: token.binaryEpoch,
+            now,
+            ttlMs,
+          };
+
+          const res = renewCASStmt.run(params);
+          return res.changes > 0;
+        });
+      },
+
+      async release(token) {
+        return withRetry(() => {
+          const params = {
+            sid: token.sessionId,
+            serve: token.serveId,
+            uuid: token.instanceUuid,
+            gen: token.ownerGeneration,
+            epoch: token.binaryEpoch,
+          };
+
+          const res = releaseStmt.run(params);
+          return res.changes > 0;
+        });
+      },
+
+      async readValid(sessionId, token) {
+        return withRetry(() => {
+          const now = Date.now();
+          const params = {
+            sid: sessionId,
+            serve: token.serveId,
+            uuid: token.instanceUuid,
+            gen: token.ownerGeneration,
+            epoch: token.binaryEpoch,
+            now,
+          };
+
+          const row = readValidStmt.get(params);
+          return row !== undefined;
+        });
+      },
+
+      async registerSelf(options) {
+        return withRetry(() => {
+          const now = Date.now();
+          const metaRow: any = selectMetaStmt.get();
+          if (!metaRow) {
+            throw new Error("routing_meta singleton row (id=1) not found in routing database.");
+          }
+          const binaryEpoch = Number(metaRow.binary_epoch);
+
+          const params = {
+            serveId: options.serveId,
+            instanceUuid: options.instanceUuid,
+            endpoint: options.endpoint,
+            binaryEpoch,
+            heartbeatAt: now,
+          };
+
+          registerSelfStmt.run(params);
+          setSelfIdentity({ serveId: options.serveId, instanceUuid: options.instanceUuid });
+        });
+      },
+
+      async heartbeat(serveId) {
+        return withRetry(() => {
+          const now = Date.now();
+          const res = heartbeatStmt.run({
+            now,
+            serveId,
+          });
+          return res.changes > 0;
+        });
+      },
+
+      async markDead(serveId) {
+        return withRetry(() => {
+          const res = markDeadStmt.run({
+            serveId,
+          });
+          return res.changes > 0;
+        });
+      },
+
+      async close() {
+        db.close();
+      },
+    };
+  } catch (error) {
+    try {
+      db.close();
+    } catch {}
+    throw error;
+  }
+}
+
+let sharedLeasePromise: Promise<RoutingLeaseDbAdapter> | null = null;
+let selfIdentity: { serveId: string; instanceUuid: string } | null = null;
+
+export function getSelfIdentity(): { serveId: string; instanceUuid: string } | null {
+  return selfIdentity;
+}
+
+export function setSelfIdentity(id: { serveId: string; instanceUuid: string } | null): void {
+  selfIdentity = id;
+}
+
+export async function getSharedRoutingLease(): Promise<RoutingLeaseDbAdapter> {
+  if (!sharedLeasePromise) {
+    sharedLeasePromise = openRoutingLeaseDb();
+  }
+  return sharedLeasePromise;
+}
+
+export function __resetSharedRoutingLease(): void {
+  sharedLeasePromise = null;
+  selfIdentity = null;
+}
