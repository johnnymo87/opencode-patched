+
+  // workstation-sqd5: the 1.17.x reconnect-storm wedge. refreshAfterBoot runs
+  // once per location boot; a reconnect/poll storm fired N concurrent refreshes
+  // for the same projectID, each with unbounded fan-out (a `git worktree list`
+  // subprocess + fs.isDir per source dir), blocking the event loop. The fix:
+  // (1) coalesce concurrent refreshes per projectID, (2) bound the fan-out.
+  const countingStrategy = (id: string, onList: () => Effect.Effect<void>): ProjectCopy.Strategy => ({
+    id: ProjectCopy.StrategyID.make(id),
+    create: () => Effect.die("unused"),
+    remove: () => Effect.die("unused"),
+    list: () => onList().pipe(Effect.as([])),
+  })
+
+  it.live("coalesces concurrent refreshes for the same projectID into one run", () =>
+    Effect.gen(function* () {
+      const input = yield* setup()
+      const copy = yield* ProjectCopy.Service
+      let listCalls = 0
+      const gate = Deferred.makeUnsafe<void>()
+      yield* copy.register(
+        countingStrategy("test/coalesce", () =>
+          Effect.sync(() => {
+            listCalls++
+          }).pipe(Effect.andThen(Deferred.await(gate))),
+        ),
+      )
+
+      // Fork many concurrent refreshes; the owner blocks inside the counting
+      // strategy while the others must coalesce onto its in-flight run.
+      const fiber = yield* Effect.forEach(
+        Array.from({ length: 16 }),
+        () => copy.refresh({ projectID: input.projectID }),
+        { concurrency: "unbounded" },
+      ).pipe(Effect.forkScoped)
+
+      // Let every caller reach the wrapper and park behind the gated owner.
+      yield* Effect.sleep("150 millis")
+      yield* Deferred.succeed(gate, undefined)
+      const results = yield* Fiber.join(fiber)
+
+      // Exactly one underlying refresh ran; every caller saw the shared result.
+      expect(listCalls).toBe(1)
+      expect(results.length).toBe(16)
+      for (const result of results) expect(result).toEqual(results[0])
+    }),
+  )
+
+  it.live("refreshes distinct projectIDs independently (dedup is keyed on projectID)", () =>
+    Effect.gen(function* () {
+      const input = yield* setup()
+      const copy = yield* ProjectCopy.Service
+      const projectB = Project.ID.make("copy-project-b")
+      yield* input.db
+        .insert(ProjectTable)
+        .values({ id: projectB, worktree: input.sourceDirectory, sandboxes: [], time_created: 1, time_updated: 1 })
+        .run()
+        .pipe(Effect.orDie)
+      yield* input.db
+        .insert(ProjectDirectoryTable)
+        .values({ project_id: projectB, directory: input.sourceDirectory })
+        .run()
+        .pipe(Effect.orDie)
+
+      let listCalls = 0
+      const gate = Deferred.makeUnsafe<void>()
+      yield* copy.register(
+        countingStrategy("test/per-project", () =>
+          Effect.sync(() => {
+            listCalls++
+          }).pipe(Effect.andThen(Deferred.await(gate))),
+        ),
+      )
+
+      const fiber = yield* Effect.forEach(
+        [input.projectID, input.projectID, projectB, projectB],
+        (projectID) => copy.refresh({ projectID }),
+        { concurrency: "unbounded" },
+      ).pipe(Effect.forkScoped)
+      yield* Effect.sleep("150 millis")
+      yield* Deferred.succeed(gate, undefined)
+      yield* Fiber.join(fiber)
+
+      // Two distinct projects => two runs; the duplicate per project coalesced.
+      expect(listCalls).toBe(2)
+    }),
+  )
+
+  it.live("bounds refresh fan-out concurrency", () =>
+    Effect.gen(function* () {
+      const input = yield* setup()
+      const copy = yield* ProjectCopy.Service
+      const n = 12
+      for (let i = 0; i < n; i++) {
+        const dir = abs(`${input.root.path}-src-${i}`)
+        yield* Effect.promise(() => fs.mkdir(dir, { recursive: true }))
+        yield* Effect.addFinalizer(() =>
+          Effect.promise(() => fs.rm(dir, { recursive: true, force: true })).pipe(Effect.ignore),
+        )
+        yield* input.db
+          .insert(ProjectDirectoryTable)
+          .values({ project_id: input.projectID, directory: dir })
+          .run()
+          .pipe(Effect.orDie)
+      }
+
+      let current = 0
+      let max = 0
+      yield* copy.register(
+        countingStrategy("test/concurrency", () =>
+          Effect.gen(function* () {
+            current++
+            max = Math.max(max, current)
+            yield* Effect.sleep("60 millis")
+            current--
+          }),
+        ),
+      )
+
+      yield* copy.refresh({ projectID: input.projectID })
+
+      expect(max).toBeLessThanOrEqual(ProjectCopy.REFRESH_CONCURRENCY)
+      expect(max).toBeGreaterThan(1)
+    }),
+  )
