+    // Single-flight wrapper: coalesce concurrent refreshes for the same
+    // projectID onto one in-flight run (see refreshInFlight above). A
+    // reconnect/poll storm boots many instances of the same project at once;
+    // without this each fired its own unbounded refresh and the herd blocked
+    // the event loop (workstation-sqd5). The owner runs refreshImpl; late
+    // callers await its result. The entry is cleared when the owner settles.
+    const refresh = Effect.fnUntraced(function* (input: RefreshInput) {
+      const existing = refreshInFlight.get(input.projectID)
+      if (existing) return yield* Deferred.await(existing)
+      const deferred = Deferred.makeUnsafe<RefreshResult, Error>()
+      refreshInFlight.set(input.projectID, deferred)
+      return yield* refreshImpl(input).pipe(
+        Effect.onExit((exit) =>
+          Effect.sync(() => {
+            if (refreshInFlight.get(input.projectID) === deferred) refreshInFlight.delete(input.projectID)
+            Deferred.doneUnsafe(deferred, exit)
+          }),
+        ),
+      )
+    })
