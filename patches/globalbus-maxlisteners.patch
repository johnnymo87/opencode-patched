 export const GlobalBus = new GlobalBusEmitter()
+// qjk4 M3.3: every `GET /global/event` SSE client attaches one
+// `GlobalBus.on("event", ...)` listener (handlers/global.ts) and the per-instance
+// `/event` disposed sub-stream attaches one more. A serve that owns many
+// sessions/TUIs (load concentrated on one serve via HRW sharding) blows past
+// Node's default cap of 10, emitting a MaxListenersExceededWarning that is both
+// noise and a false-positive that could mask a real listener leak. The
+// disposed-listener-per-client pattern is legitimate fan-out, not a leak, so
+// uncap it (0 = unlimited) rather than picking an arbitrary finite ceiling.
+GlobalBus.setMaxListeners(0)
