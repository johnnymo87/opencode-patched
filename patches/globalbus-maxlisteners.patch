@@ -0,0 +1,37 @@
+import { afterEach, expect, test } from "bun:test"
+import { GlobalBus } from "@/bus/global"
+
+// qjk4 M3.3: GlobalBus must allow unlimited "event" listeners.
+//
+// Every `GET /global/event` SSE client registers one `GlobalBus.on("event", ...)`
+// listener (server/routes/instance/httpapi/handlers/global.ts), and the
+// per-instance `/event` disposed sub-stream registers one more. A serve that
+// owns many sessions/TUIs (e.g. a swarm coordinator + workers colocated via HRW
+// sharding, or all the box's busy coding sessions concentrated on one serve)
+// therefore attaches well over Node's default cap of 10 "event" listeners. Left
+// at the default, Node emits a `MaxListenersExceededWarning` and — worse — that
+// false-positive can mask a genuine listener leak elsewhere. setMaxListeners(0)
+// = unlimited (bead workstation-qjk4).
+
+afterEach(() => {
+  GlobalBus.removeAllListeners("event")
+})
+
+test("GlobalBus allows unlimited event listeners (setMaxListeners(0))", () => {
+  expect(GlobalBus.getMaxListeners()).toBe(0)
+})
+
+test("attaching 20 event listeners emits no MaxListenersExceededWarning", () => {
+  const warnings: Error[] = []
+  const onWarning = (w: Error) => {
+    if (w.name === "MaxListenersExceededWarning") warnings.push(w)
+  }
+  process.on("warning", onWarning)
+  try {
+    const handlers = Array.from({ length: 20 }, () => () => {})
+    for (const h of handlers) GlobalBus.on("event", h)
+    expect(warnings).toHaveLength(0)
+  } finally {
+    process.off("warning", onWarning)
+  }
+})
